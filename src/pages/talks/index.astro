---
import Base from '../../layouts/Base.astro';
import TalkIndexGrid from '../../components/TalkIndexGrid.astro';
import { getCollection } from 'astro:content';

const talks = (await getCollection('talks')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);
---

<Base
  title="Talk Notes | Adarsh Sarda"
  description="Notes on AI security, red teaming, backdoors, RAG, agents, and model evaluation."
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Writing</span> / Papers and talks</p>
    <h1>Talk Notes</h1>
    <p>I explain the threat model, result, limits, and why each paper or talk matters to my work.</p>
  </div>

  <TalkIndexGrid entries={talks} />
</Base>
