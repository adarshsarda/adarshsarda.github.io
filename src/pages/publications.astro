---
import Base from '../layouts/Base.astro';
import PublicationCard from '../components/PublicationCard.astro';
import '../styles/profile.css';
import { getCollection } from 'astro:content';

const publications = (await getCollection('profile'))
  .flatMap((entry) => entry.data.type === 'publication' ? [entry.data] : [])
  .sort((a, b) => b.published_on.localeCompare(a.published_on));
if (publications.length === 0) {
  throw new Error('The profile collection has no publication records.');
}

const personId = `${Astro.site ?? Astro.url.origin}#person`;
const structuredData = {
  '@type': 'ItemList',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: publications.length,
  itemListElement: publications.map((publication, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'ScholarlyArticle',
      '@id': publication.source,
      headline: publication.title,
      datePublished: publication.published_on,
      author: publication.authors.map((author) => author.portfolio_owner
        ? { '@id': personId }
        : { '@type': 'Person', name: author.name }),
      isPartOf: {
        '@type': 'PublicationVolume',
        name: publication.venue,
        volumeNumber: String(publication.volume),
      },
      sameAs: publication.source,
    },
  })),
};
---

<Base
  title="Publications | Adarsh Sarda"
  description="Published academic work by Adarsh Sarda."
  structuredData={structuredData}
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Index 04</span> / Academic work</p>
    <h1>Publications</h1>
    <p>{publications.length === 1
      ? publications[0].index_intro.en
      : `${publications.length} peer-reviewed works and the project context behind them.`}</p>
  </div>

  {publications.map((publication, index) => (
    <PublicationCard publication={publication} index={index} />
  ))}
</Base>
