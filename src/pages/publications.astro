---
import Base from '../layouts/Base.astro';
import '../styles/profile.css';
import { getCollection } from 'astro:content';

const publicationEntry = (await getCollection('profile')).find(
  (entry) => entry.data.type === 'publication' && entry.data.slug === 'publications',
);
if (!publicationEntry || publicationEntry.data.type !== 'publication') {
  throw new Error('The canonical profile/publications publication record is missing.');
}

const publication = publicationEntry.data;
const reportedResult = publication.reported_result;
const reportedValue = reportedResult.unit === 'percent'
  ? `${reportedResult.value}%`
  : String(reportedResult.value);
const reportedMetric = reportedResult.metric === 'accuracy'
  ? 'model accuracy'
  : reportedResult.metric;
const publishedOn = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${publication.published_on}T00:00:00Z`));
const personId = `${Astro.site ?? Astro.url.origin}#person`;
const structuredData = {
  '@type': 'ScholarlyArticle',
  '@id': publication.source,
  headline: publication.title,
  datePublished: publication.published_on,
  author: publication.authors.map((author) => author.portfolio_owner
    ? { '@id': personId }
    : { '@type': 'Person', name: author.name }),
  isPartOf: {
    '@type': 'PublicationVolume',
    name: publication.venue,
    volumeNumber: String(publication.volume),
  },
  sameAs: publication.source,
};
---

<Base
  title="Publications | Adarsh Sarda"
  description="Published academic work by Adarsh Sarda."
  structuredData={structuredData}
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Index 04</span> / Academic work</p>
    <h1>Publications</h1>
    <p>{publication.index_intro.en}</p>
  </div>

  <article class="publication-card" id={publication.slug}>
    <div class="publication-head">
      <span class="publication-number">P-01</span>
      <p class="publication-type">{publication.publication_type.en} / {publication.year}</p>
    </div>
    <div class="publication-body">
      <div class="publication-lead">
        <h2>{publication.title}</h2>
        <p class="publication-authors">
          {publication.authors.map((author, index) => (
            <>
              {index > 0 && (index === publication.authors.length - 1 ? ', and ' : ', ')}
              {author.portfolio_owner
                ? <strong>{author.citation_name}</strong>
                : author.citation_name}
            </>
          ))}
        </p>
      </div>
      <div class="publication-detail">
        <p class="publication-abstract">
          Published in <em>{publication.venue}</em>, {publication.series}, volume {publication.volume},
          pages {publication.pages}. First published online {publishedOn}.
        </p>
        <p class="publication-abstract">
          {publication.summary.en} {reportedResult.attribution.en}{' '}
          {reportedResult.approximate && 'approximately '}{reportedValue} {reportedMetric}.
          The publisher describes this result for {reportedResult.scope.en}; {reportedResult.caveat.en}
        </p>
        <div class="publication-links">
          <a class="text-link" href={publication.source} target="_blank" rel="noreferrer">
            Springer / DOI <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
    <dl class="publication-citation">
      <div><dt>DOI</dt><dd>{publication.doi}</dd></div>
      <div><dt>Venue</dt><dd>{publication.venue}</dd></div>
      <div><dt>Series</dt><dd>{publication.series_abbreviation} {publication.volume}</dd></div>
      <div><dt>Contribution</dt><dd>{publication.contribution.en}</dd></div>
    </dl>
  </article>
</Base>
