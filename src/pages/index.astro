---
import Base from '../layouts/Base.astro';
import NoteCarousel from '../components/NoteCarousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TalkCarousel from '../components/TalkCarousel.astro';
import { isFeaturedProject } from '../lib/contentVisibility';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projectEntries = await getCollection('projects');
const guideEntries = (await getCollection('guides')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || (b.data.last_updated?.getTime() ?? 0) - (a.data.last_updated?.getTime() ?? 0),
);
const talkEntries = (await getCollection('talks')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);
const publicationEntries = (await getCollection('profile'))
  .flatMap((entry) => entry.data.type === 'publication'
    ? [{ key: entry.data.slug, data: entry.data }]
    : [])
  .sort((a, b) => b.data.published_on.localeCompare(a.data.published_on));

const projects = projectEntries
  .filter((entry) =>
    entry.data.type === 'project'
    && isFeaturedProject(entry)
  )
  .map((entry) => {
    const data = entry.data as Extract<typeof entry.data, { type: 'project' }>;
    return { key: data.slug, data };
  })
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectCount = projects.length;
const publicationCount = publicationEntries.length;
const guideCount = guideEntries.length;
const talkCount = talkEntries.length;
const featuredTalks = talkEntries.slice(0, 6);

const headlineMetrics: Record<string, string[]> = {
  'odsb-semantic-backdoors': [
    '100% attack success in-distribution, n=140',
    '0% false-trigger across four controls',
    '0.887 on held-out paraphrases, n=400',
  ],
};
const hasPublicCode = (data: { artifacts?: { kind: string }[] }) =>
  (data.artifacts ?? []).some((artifact) => artifact.kind === 'code');
---

<Base
  title="Adarsh Sarda | AI Security Researcher"
  description="Research and field notes on AI security, LLM red teaming, and adversarial machine learning."
  progress
  wide
>
  <section class="home-hero">
    <div class="hero-main">
      <p class="hero-name">Adarsh Sarda</p>
      <p class="eyebrow"><span>Research & field notes</span> / AI security</p>
      <h1>I build and break <em>AI systems.</em></h1>
      <p class="hero-deck">
        I work on adversarial machine learning, LLM red teaming, and experimental
        security research. Each write-up records the method, evidence, failed
        attempts, and limits of the result.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="#featured-work">Explore featured work <span aria-hidden="true">↗</span></a>
        <a class="text-link quiet" href={`${base}about/`}>About my work <span aria-hidden="true">→</span></a>
        <a class="text-link quiet" href={`${base}cv/`}>
          CV / Lebenslauf <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="portrait-frame">
        <img
          src={`${base}images/portrait.jpeg`}
          alt="Portrait outdoors beside a river"
          width="900"
          height="1600"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="portrait-note">
        <p class="note-label">Current inquiry / 2026</p>
        <p>When an AI agent can take real actions, how do you prove <strong>each tool call</strong> followed from the user's goal?</p>
        <a class="text-link quiet" href={`${base}guides/agent-security-production-checklist/`}>Working notes on agent action integrity <span aria-hidden="true">→</span></a>
      </div>
    </figure>
  </section>

  <section class="home-section principles-section" aria-labelledby="principles-heading">
    <header class="section-heading reveal">
      <h2 class="section-title" id="principles-heading"><span>01</span> Research principles</h2>
      <p>How I evaluate evidence</p>
    </header>
    <div class="principle-grid reveal-stagger">
      <div>
        <span>01</span>
        <h3>Measure statistically.</h3>
        <p>AI failures are probabilistic. Report rates, sample sizes, controls, and uncertainty.</p>
      </div>
      <div>
        <span>02</span>
        <h3>Report failed iterations.</h3>
        <p>A discarded shortcut can teach more about the system than a polished final score.</p>
      </div>
      <div>
        <span>03</span>
        <h3>Separate demos from evidence.</h3>
        <p>Installation, generalisation, utility, and real-world risk are different claims.</p>
      </div>
      <div>
        <span>04</span>
        <h3>Question perfect results.</h3>
        <p>Perfect scores demand stronger audits, not stronger adjectives.</p>
      </div>
    </div>
  </section>

  <section class="home-section research-section featured-work-section" id="featured-work" aria-labelledby="featured-work-heading">
    <header class="section-heading reveal">
      <h2 class="section-title" id="featured-work-heading"><span>02</span> Featured work</h2>
      <p>
        {projectCount.toString().padStart(2, '0')} {projectCount === 1 ? 'project' : 'projects'}
        {' / '}
        {publicationCount.toString().padStart(2, '0')} {publicationCount === 1 ? 'publication' : 'publications'}
      </p>
    </header>
    <div class="project-card-list reveal-stagger">
      {projects.map((project, index) => (
        <ProjectCard
          href={`${base}projects/${project.key}/`}
          index={index}
          data={project.data}
          metrics={headlineMetrics[project.key]}
          evidence={hasPublicCode(project.data) ? 'Report + public code' : undefined}
          headingLevel={3}
        />
      ))}
      {publicationEntries.map((publication, index) => (
        <ProjectCard
          href={`${base}publications/#${publication.key}`}
          index={index}
          indexPrefix="P"
          cta="Open publication"
          statusLabel="Venue"
          focusLabel="Role"
          headingLevel={3}
          data={{
            title: publication.data.title,
            subtitle: `${publication.data.publisher} · ${publication.data.series_abbreviation} ${publication.data.volume}`,
            summary: 'Multimodal deep-learning system (LSTM over speech and text) reaching about 86% accuracy. My earliest applied machine-learning engineering and peer-reviewed evaluation work.',
            category: `publication / ${publication.data.publication_type.en} / ${publication.data.year}`,
            status: publication.data.venue,
            domains: [publication.data.contribution.en],
          }}
        />
      ))}
    </div>
  </section>

  {guideEntries.length > 0 && (
    <section class="home-section notes-section" aria-labelledby="field-notes-heading">
      <header class="section-heading reveal">
        <h2 class="section-title" id="field-notes-heading"><span>03</span> Field Notes</h2>
        <p>{guideCount.toString().padStart(2, '0')} long-form {guideCount === 1 ? 'guide' : 'guides'}</p>
      </header>
      <NoteCarousel
        entries={guideEntries}
        hrefPrefix={`${base}guides`}
        indexHref={`${base}guides/`}
        indexCta="Open the full field-note index"
        headingLevel={3}
      />
    </section>
  )}

  {talkEntries.length > 0 && (
    <section class="home-section talks-section" aria-labelledby="talk-notes-heading">
      <header class="section-heading reveal">
        <h2 class="section-title" id="talk-notes-heading"><span>04</span> Talk Notes</h2>
        <p>{talkCount.toString().padStart(2, '0')} {talkCount === 1 ? 'note' : 'notes'} from papers and talks</p>
      </header>

      <TalkCarousel
        entries={featuredTalks}
        indexHref={`${base}talks/`}
        indexCta="Open the full talk index"
        headingLevel={3}
      />
    </section>
  )}

  <section class="home-section contact-section reveal">
    <div>
      <p class="profile-kicker">Let's talk</p>
      <h2>Interested in AI security, LLM evaluation, or applied machine learning? Let's talk.</h2>
      <p>Based in Amberg, Germany. Available immediately for working student roles at 20 hours/week, either on-site around Amberg, Regensburg, Nuremberg and nearby areas, or remote. <span class="availability-stamp">Availability updated July 2026.</span></p>
    </div>
    <div class="contact-actions">
      <a class="text-link" href="mailto:adarshsarda29@gmail.com">Email <span aria-hidden="true">→</span></a>
      <a class="text-link quiet" href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link quiet" href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .section-title {
    margin: 0;
    color: var(--ink);
    font: inherit;
    font-weight: 750;
  }

  .section-title span {
    margin-right: 10px;
    color: var(--signal);
  }

  .principle-grid h3 {
    margin: 20px 0 10px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
</style>
