---
import Base from '../layouts/Base.astro';
import NoteCarousel from '../components/NoteCarousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TalkCarousel from '../components/TalkCarousel.astro';
import { isPublishable } from '../lib/contentVisibility';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projectEntries = await getCollection('projects');
const guideEntries = (await getCollection('guides')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || (b.data.last_updated?.getTime() ?? 0) - (a.data.last_updated?.getTime() ?? 0),
);
const talkEntries = (await getCollection('talks')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);

const projects = projectEntries
  .filter((entry) =>
    entry.data.type === 'project'
    && isPublishable(entry)
    && entry.data.slug === 'odsb-semantic-backdoors'
  )
  .map((entry) => ({ key: entry.data.slug, data: entry.data }))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectCount = projects.length;
const publicationCount = 1;
const guideCount = guideEntries.length;
const talkCount = talkEntries.length;
---

<Base
  title="Adarsh Sarda | AI Security Researcher"
  description="Research and field notes on AI security, LLM red teaming, and adversarial machine learning."
  wide
>
  <section class="home-hero">
    <div class="hero-main">
      <p class="hero-name">Adarsh Sarda</p>
      <p class="eyebrow"><span>Research & field notes</span> / AI security</p>
      <h1>I build and break <em>AI systems.</em></h1>
      <p class="hero-deck">
        I work on adversarial machine learning, LLM red teaming, and experimental
        security research. Each write-up records the method, evidence, failed
        attempts, and limits of the result.
      </p>
      <div class="hero-actions">
        <a class="text-link" href={`${base}projects/`}>Read the research <span aria-hidden="true">↗</span></a>
        <a class="text-link quiet" href={`${base}about/`}>About my work <span aria-hidden="true">→</span></a>
        <a class="text-link quiet" href={`${base}cv/`}>
          CV / Lebenslauf <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="portrait-frame">
        <img
          src={`${base}images/portrait.jpeg`}
          alt="Portrait outdoors beside a river"
          width="900"
          height="1600"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="portrait-note">
        <p class="note-label">Current inquiry / 2026</p>
        <p>Can a multi-turn model learn a hidden rule based on the <strong>order of meanings</strong> rather than a keyword?</p>
      </div>
    </figure>
  </section>

  <section class="home-section principles-section">
    <header class="section-heading">
      <p><span>01</span> Research principles</p>
      <p>How I evaluate evidence</p>
    </header>
    <div class="principle-grid">
      <div>
        <span>01</span>
        <h2>Measure statistically.</h2>
        <p>AI failures are probabilistic. Report rates, sample sizes, controls, and uncertainty.</p>
      </div>
      <div>
        <span>02</span>
        <h2>Report failed iterations.</h2>
        <p>A discarded shortcut can teach more about the system than a polished final score.</p>
      </div>
      <div>
        <span>03</span>
        <h2>Separate demos from evidence.</h2>
        <p>Installation, generalisation, utility, and real-world risk are different claims.</p>
      </div>
      <div>
        <span>04</span>
        <h2>Question perfect results.</h2>
        <p>Perfect scores demand stronger audits, not stronger adjectives.</p>
      </div>
    </div>
  </section>

  <section class="home-section research-section featured-work-section">
    <header class="section-heading">
      <p><span>02</span> Featured work</p>
      <p>
        {projectCount.toString().padStart(2, '0')} {projectCount === 1 ? 'project' : 'projects'}
        {' / '}
        {publicationCount.toString().padStart(2, '0')} {publicationCount === 1 ? 'publication' : 'publications'}
      </p>
    </header>
    {projects.length > 0 && (
      <div class="project-card-list">
        {projects.map((project, index) => (
          <ProjectCard
            href={`${base}projects/${project.key}/`}
            index={index}
            data={project.data}
          />
        ))}
      </div>
    )}
    <article class="home-publication">
      <div class="home-publication-main">
        <p class="publication-kicker">Publication / Springer book chapter / 2023</p>
        <h2>Improving Mental Health Through Multimodal Emotion Detection from Speech and Text Data Using Long-Short Term Memory</h2>
        <p>D. Bhagat, A. Ray, <strong>A. Sarda</strong>, N. Dutta Roy, M. Mahmud, and D. De</p>
      </div>
      <dl class="home-publication-meta">
        <div>
          <dt>Venue</dt>
          <dd>Frontiers of ICT in Healthcare, LNNS 519</dd>
        </div>
        <div>
          <dt>DOI</dt>
          <dd>10.1007/978-981-19-5191-6_2</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>Co-author and project developer</dd>
        </div>
      </dl>
      <div class="home-publication-actions">
        <a class="text-link" href={`${base}publications/`}>Open publication <span aria-hidden="true">→</span></a>
        <a class="text-link quiet" href="https://doi.org/10.1007/978-981-19-5191-6_2" target="_blank" rel="noreferrer">Springer DOI <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  </section>

  {guideEntries.length > 0 && (
    <section class="home-section notes-section">
      <header class="section-heading">
        <p><span>03</span> Field Notes</p>
        <p>{guideCount.toString().padStart(2, '0')} long-form {guideCount === 1 ? 'guide' : 'guides'}</p>
      </header>
      <NoteCarousel
        entries={guideEntries}
        hrefPrefix={`${base}guides`}
        indexHref={`${base}guides/`}
        indexCta="Open the full field-note index"
      />
    </section>
  )}

  {talkEntries.length > 0 && (
    <section class="home-section talks-section">
      <header class="section-heading">
        <p><span>04</span> Talk Notes</p>
        <p>{talkCount.toString().padStart(2, '0')} {talkCount === 1 ? 'note' : 'notes'} from papers and talks</p>
      </header>

      <TalkCarousel
        entries={talkEntries}
        indexHref={`${base}talks/`}
        indexCta="Open the full talk index"
      />
    </section>
  )}

  <section class="home-section contact-section">
    <div>
      <p class="profile-kicker">Let's talk</p>
      <h2>Interested in AI security, LLM evaluation, or applied machine learning? Let's talk.</h2>
      <p>Based in Amberg, Germany. Available immediately for working student roles at 20 hours/week, either on-site around Amberg, Regensburg, Nuremberg and nearby areas, or remote.</p>
    </div>
    <div class="contact-actions">
      <a class="text-link" href="mailto:adarshsarda29@gmail.com">Email <span aria-hidden="true">→</span></a>
      <a class="text-link quiet" href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link quiet" href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
