---
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TalkCard from '../components/TalkCard.astro';
import { availability } from '../lib/availability';
import { isFeaturedProject } from '../lib/contentVisibility';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projectEntries = await getCollection('projects');
const guideEntries = (await getCollection('guides')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || (b.data.last_updated?.getTime() ?? 0) - (a.data.last_updated?.getTime() ?? 0),
);
const talkEntries = (await getCollection('talks')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);
const publicationEntries = (await getCollection('profile'))
  .flatMap((entry) => entry.data.type === 'publication'
    ? [{ key: entry.data.slug, data: entry.data }]
    : [])
  .sort((a, b) => b.data.published_on.localeCompare(a.data.published_on));

const projects = projectEntries
  .filter((entry) =>
    entry.data.type === 'project'
    && isFeaturedProject(entry)
  )
  .map((entry) => {
    const data = entry.data as Extract<typeof entry.data, { type: 'project' }>;
    return { key: data.slug, data };
  })
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectCount = projects.length;
const publicationCount = publicationEntries.length;
const guideCount = guideEntries.length;
const talkCount = talkEntries.length;
const featuredTalks = talkEntries.slice(0, 2);

const headlineMetrics: Record<string, string[]> = {
  'odsb-semantic-backdoors': [
    'In-distribution: 140/140 triggered',
    'Controls: 0/140 false triggers in each of four conditions',
    'Held-out paraphrases: 355/400 triggered',
  ],
};
const hasPublicCode = (data: { artifacts?: { kind: string }[] }) =>
  (data.artifacts ?? []).some((artifact) => artifact.kind === 'code');
---

<Base
  title="Adarsh Sarda | AI Security Researcher"
  description="Research and field notes on AI security, LLM red teaming, and adversarial machine learning."
  wide
>
  <section class="home-hero">
    <div class="hero-main">
      <p class="hero-name">Adarsh Sarda</p>
      <p class="eyebrow"><span>Research & field notes</span> / AI security</p>
      <h1>I build and break <em>AI systems.</em></h1>
      <p class="hero-deck">
        I work on AI security, from LLM backdoors to agent evaluation.
        Here I share my experiments, results, and what went wrong.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="#featured-work">View featured work <span aria-hidden="true">↗</span></a>
        <a class="text-link quiet" href={`${base}about/`}>About <span aria-hidden="true">→</span></a>
        <a class="text-link quiet" href={`${base}cv/`}>
          CV <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="portrait-frame">
        <img
          src={`${base}images/portrait.jpeg`}
          alt="Portrait outdoors beside a river"
          width="900"
          height="1600"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="portrait-note">
        <p class="note-label">What I’m working on</p>
        <p>When an AI agent acts, how do you show that <strong>each tool call</strong> serves the user's goal?</p>
        <a class="text-link quiet" href={`${base}guides/agent-security-production-checklist/`}>Read the agent-security checklist <span aria-hidden="true">→</span></a>
      </div>
    </figure>
  </section>

  <section class="home-section research-section featured-work-section" id="featured-work" aria-labelledby="featured-work-heading">
    <header class="section-heading">
      <h2 class="section-title" id="featured-work-heading"><span>01</span> Featured work</h2>
      <p>
        {projectCount.toString().padStart(2, '0')} {projectCount === 1 ? 'project' : 'projects'}
        {' / '}
        {publicationCount.toString().padStart(2, '0')} {publicationCount === 1 ? 'publication' : 'publications'}
      </p>
    </header>
    <div class="project-card-list">
      {projects.map((project, index) => (
        <ProjectCard
          href={`${base}projects/${project.key}/`}
          index={index}
          data={project.data}
          metrics={headlineMetrics[project.key]}
          evidence={hasPublicCode(project.data) ? 'Report + public code' : undefined}
          headingLevel={3}
        />
      ))}
      {publicationEntries.map((publication, index) => (
        <ProjectCard
          href={`${base}publications/#${publication.key}`}
          index={index}
          indexPrefix="P"
          cta="View publication"
          statusLabel="Venue"
          focusLabel="Role"
          headingLevel={3}
          data={{
            title: publication.data.title,
            subtitle: `${publication.data.publisher} · ${publication.data.series_abbreviation} ${publication.data.volume}`,
            summary: 'Speech-and-text emotion recognition built for my bachelor’s project and published with Springer in 2023.',
            category: `publication / ${publication.data.publication_type.en} / ${publication.data.year}`,
            status: publication.data.venue,
            domains: [publication.data.contribution.en],
          }}
        />
      ))}
    </div>
  </section>

  <section class="home-section principles-section" aria-labelledby="principles-heading">
    <header class="section-heading">
      <h2 class="section-title" id="principles-heading"><span>02</span> How I work</h2>
    </header>
    <div class="principle-grid">
      <div><h3>Use controls.</h3><p>Test what triggers a failure and what does not.</p></div>
      <div><h3>Show the evidence.</h3><p>Report sample sizes, uncertainty, and evaluation limits.</p></div>
      <div><h3>Document failures.</h3><p>Explain failed attempts and what changed afterward.</p></div>
      <div><h3>Check the result.</h3><p>Look for leakage and shortcuts before accepting a score.</p></div>
    </div>
  </section>

  {guideEntries.length > 0 && (
    <section class="home-section notes-section" aria-labelledby="field-notes-heading">
      <header class="section-heading">
        <h2 class="section-title" id="field-notes-heading"><span>03</span> Field Notes</h2>
        <p>{guideCount} {guideCount === 1 ? 'guide' : 'guides'}</p>
      </header>
      <div class="selected-note-grid">
        {guideEntries.slice(0, 2).map((note, index) => (
          <NoteCard href={`${base}guides/${note.id}/`} index={index} prefix="N"
            kicker="Guide" title={note.data.title} description={note.data.description}
            tags={note.data.tags} cta="Read guide" headingLevel={3} />
        ))}
      </div>
      <p class="section-index-link"><a class="text-link quiet" href={`${base}guides/`}>All guides <span aria-hidden="true">→</span></a></p>
    </section>
  )}

  {talkEntries.length > 0 && (
    <section class="home-section talks-section" aria-labelledby="talk-notes-heading">
      <header class="section-heading">
        <h2 class="section-title" id="talk-notes-heading"><span>04</span> Paper notes</h2>
        <p>{talkCount} {talkCount === 1 ? 'note' : 'notes'}</p>
      </header>

      <div class="selected-note-grid">
        {featuredTalks.map((entry, index) => <TalkCard entry={entry} index={index} headingLevel={3} />)}
      </div>
      <p class="section-index-link"><a class="text-link quiet" href={`${base}talks/`}>All paper notes <span aria-hidden="true">→</span></a></p>
    </section>
  )}

  <section class="home-section contact-section">
    <div>
      <p class="profile-kicker">Contact</p>
      <h2>Looking for a working-student role in AI security or applied ML.</h2>
      <p>{availability.en.summary} <span class="availability-stamp">{availability.en.stamp}</span></p>
    </div>
    <div class="contact-actions">
      <a class="text-link" href="mailto:adarshsarda29@gmail.com">Email <span aria-hidden="true">→</span></a>
      <a class="text-link quiet" href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link quiet" href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .section-title {
    margin: 0;
    color: var(--ink);
    font: inherit;
    font-weight: 750;
  }

  .section-title span {
    margin-right: 10px;
    color: var(--signal);
  }

  .principle-grid h3 {
    margin: 20px 0 10px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
</style>
