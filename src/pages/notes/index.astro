---
import Base from '../../layouts/Base.astro';
import NotesHub from '../../components/NotesHub.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const guideCount = (await getCollection('guides')).length;
const talkCount = (await getCollection('talks')).length;
const methodCount = (await getCollection('methods')).length;
---

<Base
  title="Writing | Adarsh Sarda"
  description="Field notes, talk notes, and reusable methods on AI security, LLM red teaming, and adversarial machine learning."
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Index 03</span> / Field Notes, Talk Notes, and Methods</p>
    <h1>Writing</h1>
    <p>Three connected paths: long-form practitioner notes, structured learning notes from papers and presentations, and reusable research methods.</p>
  </div>

  <NotesHub
    guideCount={guideCount}
    talkCount={talkCount}
    methodCount={methodCount}
    fieldHref={`${base}guides/`}
    talkHref={`${base}talks/`}
    methodHref={`${base}methods/`}
    fieldCountLabel={guideCount === 1 ? 'note' : 'notes'}
    talkCountLabel={talkCount === 1 ? 'note' : 'notes'}
    methodCountLabel={methodCount === 1 ? 'method' : 'methods'}
    fieldDescription="Long-form methodology and practitioner notes for assessing, breaking, and hardening AI systems."
    talkDescription="Talks and papers mapped into threat models, defensive lessons, and personal takeaways."
    methodDescription="Reusable research templates for experiment design, paper evaluation, robustness measurement, and threat modeling."
    fieldCta="Open Field Notes"
    talkCta="Open Talk Notes"
    methodCta="Open Methods"
  />
</Base>
