---
import Base from '../../layouts/Base.astro';
import NotesHub from '../../components/NotesHub.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const guideCount = (await getCollection('guides')).length;
const talkCount = (await getCollection('talks')).length;
const methodCount = (await getCollection('methods')).length;
---

<Base
  title="Writing | Adarsh Sarda"
  description="Course paper, practical notes, paper explainers, and methods for AI security research."
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Index 03</span> / Papers and practical notes</p>
    <h1>Writing</h1>
    <p>A course paper, practical notes, paper explainers, and methods I reuse.</p>
  </div>

  <NotesHub
    guideCount={guideCount}
    talkCount={talkCount}
    methodCount={methodCount}
    fieldHref={`${base}guides/`}
    talkHref={`${base}talks/`}
    methodHref={`${base}methods/`}
    fieldTitle="Field notes"
    fieldCountLabel={guideCount === 1 ? 'note' : 'notes'}
    talkCountLabel={talkCount === 1 ? 'note' : 'notes'}
    methodCountLabel={methodCount === 1 ? 'method' : 'methods'}
    fieldDescription="Practical notes on testing and securing AI systems."
    talkDescription="Research papers explained, with their results and limits."
    methodDescription="How I design experiments, review papers, and test robustness."
    fieldCta="View field notes"
    talkCta="View paper notes"
    methodCta="View methods"
  />

  <section class="writing-feature" aria-labelledby="student-paper-heading">
    <header class="section-heading">
      <h2 id="student-paper-heading">Course paper</h2>
      <p>June 2026</p>
    </header>
    <div class="note-card-list">
      <NoteCard
        href={`${base}reports/tracing-the-trigger.pdf`}
        index={0}
        prefix="SP"
        kicker="Non-peer-reviewed course paper"
        title="Tracing the Trigger: An Evaluation of Foundational Backdoor Attacks in Pre-trained NLP Models"
        description="A four-page Scientific Writing paper on NLP backdoors, invisible triggers, and ODSB as AI supply-chain risks. Includes a six-point audit checklist."
        headingLevel={3}
        tags={['ai-security', 'backdoor-attacks', 'nlp', 'software-supply-chain']}
        cta="Open the PDF"
        external
      />
    </div>
    <p class="paper-scope">Non-peer-reviewed course paper, not a publication or systematic review. The ODSB results come from my June 2026 project, not a second experiment or independent replication.</p>
  </section>
</Base>

<style>
  .writing-feature {
    margin-top: 52px;
  }
  .paper-scope {
    max-width: 76ch;
    color: var(--ink-soft);
    line-height: 1.65;
  }
</style>
