---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const destinations = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}projects/`, label: 'Case file' },
  { href: `${base}guides/`, label: 'Field Notes' },
  { href: `${base}talks/`, label: 'Talk Notes' },
  { href: `${base}publications/`, label: 'Publications' },
  { href: `${base}skills/`, label: 'Skills' },
  { href: `${base}cv/`, label: 'CV' },
];
---

<Base
  title="404 | Adarsh Sarda"
  description="The requested page does not exist."
  langPaths={{ en: '/', de: '/de/' }}
  noindex
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Error 404</span> / No evidence found</p>
    <h1>This page does not exist.</h1>
    <p>
      The address you followed points at nothing I have written. That is a
      finding, not a failure. Here is what does exist.
    </p>
  </div>

  <nav class="notfound-links" aria-label="Suggested pages">
    {destinations.map((destination) => (
      <a class="text-link" href={destination.href}>
        {destination.label} <span aria-hidden="true">&rarr;</span>
      </a>
    ))}
  </nav>

  <p class="notfound-hint">
    Press <kbd>`</kbd> anywhere on this site to open a terminal.
  </p>
  <p class="notfound-hint">
    Auf Deutsch: <a href={`${base}de/`}>/de/</a>
  </p>
</Base>

<style>
  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-bottom: 52px;
  }

  .notfound-hint {
    margin: 0 0 8px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .notfound-hint kbd {
    padding: 1px 6px;
    border: 1px solid var(--rule-dark);
    font-family: inherit;
    font-size: 0.72rem;
  }
</style>
