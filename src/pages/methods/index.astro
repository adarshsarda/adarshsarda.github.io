---
import Base from '../../layouts/Base.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const methods = (await getCollection('methods')).sort((a, b) =>
  (a.data.title ?? a.id).localeCompare(b.data.title ?? b.id),
);
---

<Base
  title="Methods | Adarsh Sarda"
  description="Reusable methods and templates for AI security research: experiment design, paper evaluation, robustness measurement, and threat modeling."
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Reference</span> / Methods</p>
    <h1>Methods</h1>
    <p>Reusable methods and templates I apply across projects: how I design experiments, evaluate papers, measure robustness, and model threats.</p>
  </div>

  <div class="note-card-list">
    {methods.map((method, index) => (
      <NoteCard
        href={`${base}methods/${method.data.slug ?? method.id}/`}
        index={index}
        prefix="M"
        kicker="Method"
        title={method.data.title ?? method.id}
        tags={method.data.tags}
        cta="Read the method"
      />
    ))}
  </div>
</Base>
