---
import Base from '../../layouts/Base.astro';
import '../../styles/profile.css';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Über mich | Adarsh Sarda"
  description="Forschungsprofil, Erfahrung und technische Schwerpunkte von Adarsh Sarda."
  lang="de"
  wide
>
  <div class="page-head profile-head">
    <p class="eyebrow"><span>Profil 01</span> / Forschung und Erfahrung</p>
    <h1>Über mich</h1>
    <p>
      Ich entwickle KI-Systeme und teste, wo sie versagen.
    </p>
  </div>

  <div class="profile-layout">
    <article class="profile-story">
      <section class="profile-card">
        <p class="profile-kicker">Aktueller Fokus</p>
        <h2>Ich teste KI-Systeme unter Angriff.</h2>
        <p>
          Ich studiere den M.Sc. Artificial Intelligence for Industrial Applications an der
          OTH Amberg-Weiden mit Schwerpunkt AI Security & Privacy. Meine Arbeit umfasst
          semantische LLM-Backdoors, adversarielle Evaluation, Deepfake-Detector-Sicherheit
          und Modell-Evaluationen.
        </p>
        <p>
          Ich trenne überzeugende Demos von belastbarer Evidenz. Dafür plane ich Kontrollen,
          messe probabilistisches Verhalten, dokumentiere Fehlversuche und benenne Grenzen.
        </p>
      </section>

      <section class="profile-card profile-card--edu" aria-labelledby="ausbildung-heading">
        <h2 class="profile-kicker" id="ausbildung-heading">Ausbildung</h2>
        <div class="timeline-list">
          <div class="timeline-entry">
            <p class="timeline-date">03/2025 - heute</p>
            <div>
              <h3>M.Sc. Artificial Intelligence for Industrial Applications</h3>
              <p>OTH Amberg-Weiden, Bayern</p>
              <p>Fokus: AI Security & Privacy, Machine Learning, NLP, Computer Vision und sicheres KI-Systemdesign.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <p class="timeline-date">08/2019 - 06/2023</p>
            <div>
              <h3>B.Tech Information Technology</h3>
              <p>Institute of Engineering and Management, Kolkata</p>
              <p>CGPA 8.6/10. Die Abschlussarbeit führte zu einer co-autorierten Springer-Publikation über multimodale Emotionserkennung.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="profile-card profile-card--work">
        <p class="profile-kicker">Beruflicher Hintergrund</p>
        <h2>Forschung, die technische Entscheidungen unterstützt.</h2>
        <p>
          Von Januar 2023 bis Oktober 2024 war ich AI Research Analyst bei GreyB Research Pte.
          Dort verband ich Patentanalytik, Technology Intelligence und technische Kommunikation
          für internationale Kunden.
        </p>
        <ul class="profile-list">
          <li>Entwickelte ein ML-System zur automatisierten Patent-Technologieklassifikation.</li>
          <li>Analysierte Verletzungsrisiken und Prior Art in AI/ML, Blockchain, 3GPP und IETF.</li>
          <li>Verglich Patentansprüche mit technischen Implementierungen und Produktfunktionen.</li>
          <li>Erstellte Technologielandschaften und Entscheidungsbriefings für Legal, Strategie und R&amp;D.</li>
        </ul>
      </section>
    </article>

    <aside class="profile-facts" aria-label="Profildaten">
      <figure class="profile-photo-card">
        <img
          src={`${base}images/portrait.jpeg`}
          alt="Porträt im Freien neben einem Fluss"
          width="900"
          height="1600"
          loading="lazy"
        />
        <figcaption>
          <span>Porträt</span>
          <span>Persönlicher Kontext</span>
        </figcaption>
      </figure>
      <div class="fact-block">
        <p class="fact-label">Standort</p>
        <p>Amberg, Deutschland</p>
      </div>
      <div class="fact-block">
        <p class="fact-label">Verfügbarkeit</p>
        <p>Werkstudent, 20 Std./Woche<br />Sofortiger Start<br />Amberg, Regensburg, Nürnberg<br />und Umgebung, oder remote<br /><span class="availability-stamp">Aktualisiert im Juli 2026</span></p>
      </div>
      <div class="fact-block">
        <p class="fact-label">Forschung</p>
        <p>LLM-Sicherheit<br />Adversarial ML<br />Deepfake-Sicherheit<br />KI-Evaluation</p>
      </div>
      <div class="fact-block">
        <p class="fact-label">Technisch</p>
        <p>Python<br />PyTorch<br />Scikit-learn<br />NLP und LLMs<br />Computer Vision</p>
      </div>
      <div class="fact-block">
        <p class="fact-label">Sprachen</p>
        <p>Englisch C1<br />Deutsch B1<br />Hindi, Muttersprache</p>
      </div>
      <div class="fact-block">
        <p class="fact-label">Lebenslauf</p>
        <p>
          <a href={`${base}de/cv/`}>Deutscher Lebenslauf</a>
        </p>
      </div>
      <div class="fact-block">
        <p class="fact-label">Kontakt</p>
        <p>
          <a href="mailto:adarshsarda29@gmail.com">E-Mail</a><br />
          <a href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn</a><br />
          <a href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub</a>
        </p>
      </div>
    </aside>
  </div>

  <section class="collaboration-strip">
    <p class="profile-kicker">Offen für</p>
    <h2>Ich suche Werkstudentenrollen und Forschungskollaborationen in KI-Sicherheit, LLM-Evaluation und angewandtem Machine Learning.</h2>
    <a class="text-link" href="mailto:adarshsarda29@gmail.com">Gespräch starten <span aria-hidden="true">→</span></a>
  </section>
</Base>
