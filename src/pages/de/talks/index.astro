---
import Base from '../../../layouts/Base.astro';
import TalkIndexGrid from '../../../components/TalkIndexGrid.astro';
import { getCollection } from 'astro:content';

const talks = (await getCollection('talksDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);
---

<Base
  title="Talk-Notizen | Adarsh Sarda"
  description="Strukturierte Lernnotizen aus Vorträgen und Papers zu KI-Sicherheit, Red Teaming, Backdoors, RAG, Agents und Modell-Evaluation."
  lang="de"
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Notizen</span> / vernetzte Lernartefakte</p>
    <h1>Talk-Notizen</h1>
    <p>
      Vorträge und Papers, eingeordnet nach Threat Models, defensiven Erkenntnissen, persönlichen
      Takeaways und Verbindungen zu meinen KI-Sicherheits-Feldnotizen.
    </p>
  </div>

  <TalkIndexGrid entries={talks} hrefPrefix="/de/talks" lang="de" />
</Base>
