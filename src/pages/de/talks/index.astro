---
import Base from '../../../layouts/Base.astro';
import TalkIndexGrid from '../../../components/TalkIndexGrid.astro';
import { getCollection } from 'astro:content';

const talks = (await getCollection('talksDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);
---

<Base
  title="Paper-Notizen | Adarsh Sarda"
  description="Notizen zu Papers und Vorträgen über KI-Sicherheit, Red Teaming, Backdoors, RAG, Agenten und Modellbewertung."
  lang="de"
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Texte</span> / Papers und Vorträge</p>
    <h1>Paper-Notizen</h1>
    <p>
      Ich erkläre das Bedrohungsmodell, die Ergebnisse und die Grenzen jedes Papers oder Vortrags.
    </p>
  </div>

  <TalkIndexGrid entries={talks} hrefPrefix="/de/talks" lang="de" />
</Base>
