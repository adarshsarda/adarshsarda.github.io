---
import Base from '../../layouts/Base.astro';
import NoteCarousel from '../../components/NoteCarousel.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TalkCarousel from '../../components/TalkCarousel.astro';
import { isFeaturedProject } from '../../lib/contentVisibility';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projectEntries = await getCollection('projectsDe');
const guideEntries = (await getCollection('guidesDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || (b.data.last_updated?.getTime() ?? 0) - (a.data.last_updated?.getTime() ?? 0),
);
const talkEntries = (await getCollection('talksDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);
const publicationEntries = (await getCollection('profile'))
  .flatMap((entry) => entry.data.type === 'publication'
    ? [{ key: entry.data.slug, data: entry.data }]
    : [])
  .sort((a, b) => b.data.published_on.localeCompare(a.data.published_on));

const projects = projectEntries
  .filter((entry) =>
    entry.data.type === 'project'
    && isFeaturedProject(entry)
  )
  .map((entry) => {
    const data = entry.data as Extract<typeof entry.data, { type: 'project' }>;
    return { key: data.slug, data };
  })
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectCount = projects.length;
const publicationCount = publicationEntries.length;
const guideCount = guideEntries.length;
const talkCount = talkEntries.length;
const featuredTalks = talkEntries.slice(0, 6);

const headlineMetrics: Record<string, string[]> = {
  'odsb-semantic-backdoors': [
    '100% Angriffserfolg in-distribution, n=140',
    '0% False-Trigger über vier Kontrollen',
    '0,887 auf ungesehenen Paraphrasen, n=400',
  ],
};
const hasPublicCode = (data: { artifacts?: { kind: string }[] }) =>
  (data.artifacts ?? []).some((artifact) => artifact.kind === 'code');
---

<Base
  title="Adarsh Sarda | KI-Sicherheitsforscher"
  description="Forschung und Notizen zu KI-Sicherheit, LLM Red Teaming und adversarial Machine Learning."
  lang="de"
  progress
  wide
>
  <section class="home-hero">
    <div class="hero-main">
      <p class="hero-name">Adarsh Sarda</p>
      <p class="eyebrow"><span>Forschung & Notizen</span> / KI-Sicherheit</p>
      <h1>Ich baue und prüfe <em>KI-Systeme.</em></h1>
      <p class="hero-deck">
        Ich arbeite an adversarial Machine Learning, LLM Red Teaming und
        experimenteller Sicherheitsforschung. Die technischen Fallstudien bleiben
        dort auf Englisch, wo Präzision und belegbare Claims wichtig sind.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="#ausgewaehlte-arbeiten">Arbeiten ansehen <span aria-hidden="true">↗</span></a>
        <a class="text-link quiet" href={`${base}de/about/`}>Über meine Arbeit <span aria-hidden="true">→</span></a>
        <a class="text-link quiet" href={`${base}de/cv/`}>
          Lebenslauf <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="portrait-frame">
        <img
          src={`${base}images/portrait.jpeg`}
          alt="Porträt im Freien neben einem Fluss"
          width="900"
          height="1600"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="portrait-note">
        <p class="note-label">Aktuelle Frage / 2026</p>
        <p>Wenn ein KI-Agent echte Aktionen ausführen kann, wie weist man nach, dass <strong>jeder Tool-Aufruf</strong> dem autorisierten Ziel des Nutzers folgt?</p>
        <a class="text-link quiet" href={`${base}de/guides/agent-security-production-checklist/`}>Notizen zur Integrität von Agentenaktionen <span aria-hidden="true">→</span></a>
      </div>
    </figure>
  </section>

  <section class="home-section principles-section" aria-labelledby="forschungsprinzipien-heading">
    <header class="section-heading reveal">
      <h2 class="section-title" id="forschungsprinzipien-heading"><span>01</span> Forschungsprinzipien</h2>
      <p>Wie ich Evidenz bewerte</p>
    </header>
    <div class="principle-grid reveal-stagger">
      <div>
        <span>01</span>
        <h3>Statistisch messen.</h3>
        <p>KI-Fehler sind probabilistisch. Ich berichte Raten, Stichproben, Kontrollen und Unsicherheit.</p>
      </div>
      <div>
        <span>02</span>
        <h3>Fehlversuche dokumentieren.</h3>
        <p>Ein verworfener Shortcut erklärt oft mehr über das System als ein polierter Endwert.</p>
      </div>
      <div>
        <span>03</span>
        <h3>Demos von Evidenz trennen.</h3>
        <p>Installation, Generalisierung, Utility und reales Risiko sind unterschiedliche Aussagen.</p>
      </div>
      <div>
        <span>04</span>
        <h3>Perfekte Ergebnisse prüfen.</h3>
        <p>Perfekte Scores brauchen stärkere Audits, nicht stärkere Adjektive.</p>
      </div>
    </div>
  </section>

  <section class="home-section research-section featured-work-section" id="ausgewaehlte-arbeiten" aria-labelledby="ausgewaehlte-arbeiten-heading">
    <header class="section-heading reveal">
      <h2 class="section-title" id="ausgewaehlte-arbeiten-heading"><span>02</span> Ausgewählte Arbeiten</h2>
      <p>
        {projectCount.toString().padStart(2, '0')} {projectCount === 1 ? 'Projekt' : 'Projekte'}
        {' / '}
        {publicationCount.toString().padStart(2, '0')} {publicationCount === 1 ? 'Publikation' : 'Publikationen'}
      </p>
    </header>
    <div class="project-card-list reveal-stagger">
      {projects.map((project, index) => (
        <ProjectCard
          href={`${base}de/projects/${project.key}/`}
          index={index}
          data={project.data}
          lang="de"
          metrics={headlineMetrics[project.key]}
          evidence={hasPublicCode(project.data) ? 'Bericht + öffentlicher Code' : undefined}
          headingLevel={3}
        />
      ))}
      {publicationEntries.map((publication, index) => (
        <ProjectCard
          href={`${base}de/publications/#${publication.key}`}
          index={index}
          indexPrefix="P"
          cta="Publikation öffnen"
          statusLabel="Publikationsort"
          focusLabel="Rolle"
          headingLevel={3}
          data={{
            title: publication.data.title,
            subtitle: `${publication.data.publisher} · ${publication.data.series_abbreviation} ${publication.data.volume}`,
            summary: 'Multimodales Deep-Learning-System (LSTM über Sprache und Text) mit rund 86% Genauigkeit. Meine früheste angewandte ML-Engineering- und begutachtete Evaluationsarbeit.',
            category: `Publikation / ${publication.data.publication_type.de} / ${publication.data.year}`,
            status: publication.data.venue,
            domains: [publication.data.contribution.de],
          }}
          lang="de"
        />
      ))}
    </div>
  </section>

  {guideEntries.length > 0 && (
    <section class="home-section notes-section" aria-labelledby="feldnotizen-heading">
      <header class="section-heading reveal">
        <h2 class="section-title" id="feldnotizen-heading"><span>03</span> Feldnotizen</h2>
        <p>{guideCount.toString().padStart(2, '0')} {guideCount === 1 ? 'Guide' : 'Guides'}</p>
      </header>
      <NoteCarousel
        entries={guideEntries}
        hrefPrefix={`${base}de/guides`}
        previousLabel="Vorherige Feldnotiz anzeigen"
        nextLabel="Nächste Feldnotiz anzeigen"
        carouselLabel="Feldnotizen-Karussell"
        indexHref={`${base}de/guides/`}
        indexCta="Vollständigen Feldnotiz-Index öffnen"
        kicker="Praxisnotiz"
        cta="Notiz lesen"
        headingLevel={3}
      />
    </section>
  )}

  {talkEntries.length > 0 && (
    <section class="home-section talks-section" aria-labelledby="talk-notizen-heading">
      <header class="section-heading reveal">
        <h2 class="section-title" id="talk-notizen-heading"><span>04</span> Talk-Notizen</h2>
        <p>{talkCount.toString().padStart(2, '0')} {talkCount === 1 ? 'Notiz' : 'Notizen'} aus Papers und Vorträgen</p>
      </header>

      <TalkCarousel
        entries={featuredTalks}
        hrefPrefix="/de/talks"
        lang="de"
        previousLabel="Vorherige Talk Note anzeigen"
        nextLabel="Nächste Talk Note anzeigen"
        carouselLabel="Talk-Notizen-Karussell"
        indexHref={`${base}de/talks/`}
        indexCta="Vollständigen Talk-Index öffnen"
        headingLevel={3}
      />
    </section>
  )}

  <section class="home-section contact-section reveal">
    <div>
      <p class="profile-kicker">Kontakt</p>
      <h2>Interessiert an KI-Sicherheit, LLM-Evaluation oder angewandtem Machine Learning? Sprechen wir.</h2>
      <p>Ich bin in Amberg, Deutschland, und für Werkstudentenrollen mit 20 Stunden pro Woche verfügbar, vor Ort in der Region oder remote. <span class="availability-stamp">Verfügbarkeit aktualisiert im Juli 2026.</span></p>
    </div>
    <div class="contact-actions">
      <a class="text-link" href="mailto:adarshsarda29@gmail.com">E-Mail <span aria-hidden="true">→</span></a>
      <a class="text-link quiet" href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link quiet" href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .section-title {
    margin: 0;
    color: var(--ink);
    font: inherit;
    font-weight: 750;
  }

  .section-title span {
    margin-right: 10px;
    color: var(--signal);
  }

  .principle-grid h3 {
    margin: 20px 0 10px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
</style>
