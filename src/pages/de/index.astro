---
import Base from '../../layouts/Base.astro';
import HeroPortrait from '../../components/HeroPortrait.astro';
import NoteCarousel from '../../components/NoteCarousel.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TalkCarousel from '../../components/TalkCarousel.astro';
import { isPublishable } from '../../lib/contentVisibility';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projectEntries = await getCollection('projectsDe');
const guideEntries = (await getCollection('guidesDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || (b.data.last_updated?.getTime() ?? 0) - (a.data.last_updated?.getTime() ?? 0),
);
const talkEntries = (await getCollection('talksDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);

const projects = projectEntries
  .filter((entry) =>
    entry.data.type === 'project'
    && isPublishable(entry)
    && entry.data.slug === 'odsb-semantic-backdoors'
  )
  .map((entry) => ({ key: entry.data.slug, data: entry.data }))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectCount = projects.length;
const publicationCount = 1;
const guideCount = guideEntries.length;
const talkCount = talkEntries.length;
const publicationCard = {
  title: 'Multimodale Emotionserkennung für Screenings zur psychischen Gesundheit',
  subtitle: 'Springer-Buchkapitel, Frontiers of ICT in Healthcare, LNNS 519',
  summary: 'Begutachtete Arbeit zu einem LSTM-basierten Sprach- und Textsystem zur Emotionserkennung, mit meinem Beitrag als Co-Autor und Projektentwickler.',
  category: 'Publikation / Springer-Buchkapitel / 2023',
  status: 'Frontiers of ICT in Healthcare, LNNS 519',
  skills: ['lstm', 'multimodal', 'speech', 'text', 'python', 'mental-health'],
  domains: ['Co-Autor', 'Projektentwickler'],
};
---

<Base
  title="Adarsh Sarda | KI-Sicherheitsforscher"
  description="Forschung und Notizen zu KI-Sicherheit, LLM Red Teaming und adversarial Machine Learning."
  lang="de"
  progress
  wide
>
  <section class="home-hero">
    <div class="hero-main">
      <p class="hero-name">Adarsh Sarda</p>
      <p class="eyebrow"><span>Forschung & Notizen</span> / KI-Sicherheit</p>
      <h1>Ich baue und prüfe <em>KI-Systeme.</em></h1>
      <p class="hero-deck">
        Ich arbeite an adversarial Machine Learning, LLM Red Teaming und
        experimenteller Sicherheitsforschung. Die technischen Fallstudien bleiben
        dort auf Englisch, wo Präzision und belegbare Claims wichtig sind.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="#ausgewaehlte-arbeiten">Arbeiten ansehen <span aria-hidden="true">↗</span></a>
        <a class="text-link quiet" href={`${base}de/about/`}>Über meine Arbeit <span aria-hidden="true">→</span></a>
        <a class="text-link quiet" href={`${base}de/cv/`}>
          Lebenslauf <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <HeroPortrait lang="de">
      <p>Wenn ein KI-Agent echte Aktionen ausführen kann, wie weist man nach, dass <strong>jeder Tool-Aufruf</strong> dem autorisierten Ziel des Nutzers folgt?</p>
    </HeroPortrait>
  </section>

  <section class="home-section principles-section">
    <header class="section-heading reveal">
      <p><span>01</span> Forschungsprinzipien</p>
      <p>Wie ich Evidenz bewerte</p>
    </header>
    <div class="principle-grid reveal-stagger">
      <div>
        <span>01</span>
        <h2>Statistisch messen.</h2>
        <p>KI-Fehler sind probabilistisch. Ich berichte Raten, Stichproben, Kontrollen und Unsicherheit.</p>
      </div>
      <div>
        <span>02</span>
        <h2>Fehlversuche dokumentieren.</h2>
        <p>Ein verworfener Shortcut erklärt oft mehr über das System als ein polierter Endwert.</p>
      </div>
      <div>
        <span>03</span>
        <h2>Demos von Evidenz trennen.</h2>
        <p>Installation, Generalisierung, Utility und reales Risiko sind unterschiedliche Aussagen.</p>
      </div>
      <div>
        <span>04</span>
        <h2>Perfekte Ergebnisse prüfen.</h2>
        <p>Perfekte Scores brauchen stärkere Audits, nicht stärkere Adjektive.</p>
      </div>
    </div>
  </section>

  <section class="home-section research-section featured-work-section" id="ausgewaehlte-arbeiten">
    <header class="section-heading reveal">
      <p><span>02</span> Ausgewählte Arbeiten</p>
      <p>
        {projectCount.toString().padStart(2, '0')} {projectCount === 1 ? 'Projekt' : 'Projekte'}
        {' / '}
        {publicationCount.toString().padStart(2, '0')} {publicationCount === 1 ? 'Publikation' : 'Publikationen'}
      </p>
    </header>
    <div class="project-card-list reveal-stagger">
      {projects.map((project, index) => (
        <ProjectCard
          href={`${base}de/projects/${project.key}/`}
          index={index}
          data={project.data}
          lang="de"
        />
      ))}
      <ProjectCard
        href={`${base}de/publications/`}
        index={0}
        indexPrefix="P"
        cta="Publikation öffnen"
        statusLabel="Publikationsort"
        focusLabel="Rolle"
        data={publicationCard}
        lang="de"
      />
    </div>
  </section>

  {guideEntries.length > 0 && (
    <section class="home-section notes-section">
      <header class="section-heading reveal">
        <p><span>03</span> Feldnotizen</p>
        <p>{guideCount.toString().padStart(2, '0')} {guideCount === 1 ? 'Guide' : 'Guides'}</p>
      </header>
      <NoteCarousel
        entries={guideEntries}
        hrefPrefix={`${base}de/guides`}
        previousLabel="Vorherige Feldnotiz anzeigen"
        nextLabel="Nächste Feldnotiz anzeigen"
        carouselLabel="Feldnotizen-Karussell"
        indexHref={`${base}de/guides/`}
        indexCta="Vollständigen Feldnotiz-Index öffnen"
        kicker="Praxisnotiz"
        cta="Notiz lesen"
      />
    </section>
  )}

  {talkEntries.length > 0 && (
    <section class="home-section talks-section">
      <header class="section-heading reveal">
        <p><span>04</span> Talk-Notizen</p>
        <p>{talkCount.toString().padStart(2, '0')} {talkCount === 1 ? 'Notiz' : 'Notizen'} aus Papers und Vorträgen</p>
      </header>

      <TalkCarousel
        entries={talkEntries}
        hrefPrefix="/de/talks"
        lang="de"
        previousLabel="Vorherige Talk Note anzeigen"
        nextLabel="Nächste Talk Note anzeigen"
        carouselLabel="Talk-Notizen-Karussell"
        indexHref={`${base}de/talks/`}
        indexCta="Vollständigen Talk-Index öffnen"
      />
    </section>
  )}

  <section class="home-section contact-section reveal">
    <div>
      <p class="profile-kicker">Kontakt</p>
      <h2>Interessiert an KI-Sicherheit, LLM-Evaluation oder angewandtem Machine Learning? Sprechen wir.</h2>
      <p>Ich bin in Amberg, Deutschland, und für Werkstudentenrollen mit 20 Stunden pro Woche verfügbar, vor Ort in der Region oder remote.</p>
    </div>
    <div class="contact-actions">
      <a class="text-link" href="mailto:adarshsarda29@gmail.com">Email <span aria-hidden="true">→</span></a>
      <a class="text-link quiet" href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link quiet" href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
