---
import Base from '../../layouts/Base.astro';
import NoteCard from '../../components/NoteCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TalkCard from '../../components/TalkCard.astro';
import { availability } from '../../lib/availability';
import { isFeaturedProject } from '../../lib/contentVisibility';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projectEntries = await getCollection('projectsDe');
const guideEntries = (await getCollection('guidesDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || (b.data.last_updated?.getTime() ?? 0) - (a.data.last_updated?.getTime() ?? 0),
);
const talkEntries = (await getCollection('talksDe')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
    || b.data.last_updated.getTime() - a.data.last_updated.getTime(),
);
const publicationEntries = (await getCollection('profile'))
  .flatMap((entry) => entry.data.type === 'publication'
    ? [{ key: entry.data.slug, data: entry.data }]
    : [])
  .sort((a, b) => b.data.published_on.localeCompare(a.data.published_on));

const projects = projectEntries
  .filter((entry) =>
    entry.data.type === 'project'
    && isFeaturedProject(entry)
  )
  .map((entry) => {
    const data = entry.data as Extract<typeof entry.data, { type: 'project' }>;
    return { key: data.slug, data };
  })
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectCount = projects.length;
const publicationCount = publicationEntries.length;
const guideCount = guideEntries.length;
const talkCount = talkEntries.length;
const featuredTalks = talkEntries.slice(0, 2);

const headlineMetrics: Record<string, string[]> = {
  'odsb-semantic-backdoors': [
    'In-distribution: 140/140 ausgelöst',
    'Kontrollen: je 0/140 Fehlauslösungen in vier Bedingungen',
    'Ungesehene Paraphrasen: 355/400 ausgelöst',
  ],
};
const hasPublicCode = (data: { artifacts?: { kind: string }[] }) =>
  (data.artifacts ?? []).some((artifact) => artifact.kind === 'code');
---

<Base
  title="Adarsh Sarda | KI-Sicherheitsforscher"
  description="Forschung und Notizen zu KI-Sicherheit, LLM Red Teaming und adversarial Machine Learning."
  lang="de"
  wide
>
  <section class="home-hero">
    <div class="hero-main">
      <p class="hero-name">Adarsh Sarda</p>
      <p class="eyebrow"><span>Forschung & Notizen</span> / KI-Sicherheit</p>
      <h1>Ich baue KI-Systeme und <em>bringe sie an ihre Grenzen.</em></h1>
      <p class="hero-deck">
        Ich arbeite an KI-Sicherheit, von LLM-Backdoors bis zur Evaluation von Agenten.
        Hier teile ich meine Experimente, Ergebnisse und Fehlversuche.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="#ausgewaehlte-arbeiten">Arbeiten ansehen <span aria-hidden="true">↗</span></a>
        <a class="text-link quiet" href={`${base}de/about/`}>Über mich <span aria-hidden="true">→</span></a>
        <a class="text-link quiet" href={`${base}de/cv/`}>
          Lebenslauf <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="portrait-frame">
        <img
          src={`${base}images/portrait.jpeg`}
          alt="Porträt im Freien neben einem Fluss"
          width="900"
          height="1600"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="portrait-note">
        <p class="note-label">Woran ich arbeite</p>
        <p>Wenn ein KI-Agent handelt, wie weist man nach, dass <strong>jeder Tool-Aufruf</strong> dem Ziel des Nutzers dient?</p>
        <a class="text-link quiet" href={`${base}de/guides/agent-security-production-checklist/`}>Checkliste für Agentensicherheit <span aria-hidden="true">→</span></a>
      </div>
    </figure>
  </section>

  <section class="home-section research-section featured-work-section" id="ausgewaehlte-arbeiten" aria-labelledby="ausgewaehlte-arbeiten-heading">
    <header class="section-heading">
      <h2 class="section-title" id="ausgewaehlte-arbeiten-heading"><span>01</span> Ausgewählte Arbeiten</h2>
      <p>
        {projectCount.toString().padStart(2, '0')} {projectCount === 1 ? 'Projekt' : 'Projekte'}
        {' / '}
        {publicationCount.toString().padStart(2, '0')} {publicationCount === 1 ? 'Publikation' : 'Publikationen'}
      </p>
    </header>
    <div class="project-card-list">
      {projects.map((project, index) => (
        <ProjectCard
          href={`${base}de/projects/${project.key}/`}
          index={index}
          data={project.data}
          lang="de"
          metrics={headlineMetrics[project.key]}
          evidence={hasPublicCode(project.data) ? 'Bericht + öffentlicher Code' : undefined}
          headingLevel={3}
        />
      ))}
      {publicationEntries.map((publication, index) => (
        <ProjectCard
          href={`${base}de/publications/#${publication.key}`}
          index={index}
          indexPrefix="P"
          cta="Publikation ansehen"
          statusLabel="Publikationsort"
          focusLabel="Rolle"
          headingLevel={3}
          data={{
            title: publication.data.title,
            subtitle: `${publication.data.publisher} · ${publication.data.series_abbreviation} ${publication.data.volume}`,
            summary: 'Emotionserkennung aus Sprache und Text, entwickelt in meinem Bachelorprojekt und 2023 bei Springer veröffentlicht.',
            category: `Publikation / ${publication.data.publication_type.de} / ${publication.data.year}`,
            status: publication.data.venue,
            domains: [publication.data.contribution.de],
          }}
          lang="de"
        />
      ))}
    </div>
  </section>

  <section class="home-section principles-section" aria-labelledby="forschungsprinzipien-heading">
    <header class="section-heading">
      <h2 class="section-title" id="forschungsprinzipien-heading"><span>02</span> Wie ich arbeite</h2>
    </header>
    <div class="principle-grid">
      <div><h3>Kontrollen einsetzen.</h3><p>Prüfen, was einen Fehler auslöst und was nicht.</p></div>
      <div><h3>Belege zeigen.</h3><p>Stichprobengrößen, Unsicherheit und Grenzen angeben.</p></div>
      <div><h3>Fehlversuche dokumentieren.</h3><p>Erklären, was nicht funktioniert hat und was ich geändert habe.</p></div>
      <div><h3>Ergebnisse prüfen.</h3><p>Nach Datenlecks und Abkürzungen suchen, bevor ich einen Messwert akzeptiere.</p></div>
    </div>
  </section>

  {guideEntries.length > 0 && (
    <section class="home-section notes-section" aria-labelledby="feldnotizen-heading">
      <header class="section-heading">
        <h2 class="section-title" id="feldnotizen-heading"><span>03</span> Feldnotizen</h2>
        <p>{guideCount} {guideCount === 1 ? 'Leitfaden' : 'Leitfäden'}</p>
      </header>
      <div class="selected-note-grid">
        {guideEntries.slice(0, 2).map((note, index) => (
          <NoteCard href={`${base}de/guides/${note.id}/`} index={index} prefix="N"
            kicker="Leitfaden" title={note.data.title} description={note.data.description}
            tags={note.data.tags} cta="Leitfaden lesen" headingLevel={3} />
        ))}
      </div>
      <p class="section-index-link"><a class="text-link quiet" href={`${base}de/guides/`}>Alle Leitfäden <span aria-hidden="true">→</span></a></p>
    </section>
  )}

  {talkEntries.length > 0 && (
    <section class="home-section talks-section" aria-labelledby="talk-notizen-heading">
      <header class="section-heading">
        <h2 class="section-title" id="talk-notizen-heading"><span>04</span> Paper-Notizen</h2>
        <p>{talkCount} {talkCount === 1 ? 'Notiz' : 'Notizen'}</p>
      </header>

      <div class="selected-note-grid">
        {featuredTalks.map((entry, index) => <TalkCard entry={entry} index={index}
          hrefPrefix={`${base}de/talks`} lang="de" headingLevel={3} />)}
      </div>
      <p class="section-index-link"><a class="text-link quiet" href={`${base}de/talks/`}>Alle Paper-Notizen <span aria-hidden="true">→</span></a></p>
    </section>
  )}

  <section class="home-section contact-section">
    <div>
      <p class="profile-kicker">Kontakt</p>
      <h2>Ich suche eine Werkstudentenstelle in KI-Sicherheit oder angewandtem ML.</h2>
      <p>{availability.de.summary} <span class="availability-stamp">{availability.de.stamp}</span></p>
    </div>
    <div class="contact-actions">
      <a class="text-link" href="mailto:adarshsarda29@gmail.com">E-Mail <span aria-hidden="true">→</span></a>
      <a class="text-link quiet" href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link quiet" href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<style>
  .section-title {
    margin: 0;
    color: var(--ink);
    font: inherit;
    font-weight: 750;
  }

  .section-title span {
    margin-right: 10px;
    color: var(--signal);
  }

  .principle-grid h3 {
    margin: 20px 0 10px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
</style>
