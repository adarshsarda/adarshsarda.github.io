---
import Base from '../../../layouts/Base.astro';
import NotesHub from '../../../components/NotesHub.astro';
import NoteCard from '../../../components/NoteCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const guideCount = (await getCollection('guidesDe')).length;
const talkCount = (await getCollection('talksDe')).length;
const methodCount = (await getCollection('methodsDe')).length;
---

<Base
  title="Texte | Adarsh Sarda"
  description="Kursarbeit, Praxisnotizen, Paper-Notizen und Methoden zu KI-Sicherheit."
  lang="de"
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Index 03</span> / Studienarbeit und Notizen</p>
    <h1>Texte</h1>
    <p>
      Eine Kursarbeit, Praxisnotizen, Paper-Notizen und Methoden, die ich in meiner Forschung nutze.
    </p>
  </div>

  <NotesHub
    guideCount={guideCount}
    talkCount={talkCount}
    methodCount={methodCount}
    fieldHref={`${base}de/guides/`}
    talkHref={`${base}de/talks/`}
    methodHref={`${base}de/methods/`}
    fieldTitle="Feldnotizen"
    talkTitle="Paper-Notizen"
    methodTitle="Methoden"
    fieldCountLabel={guideCount === 1 ? 'Notiz' : 'Notizen'}
    talkCountLabel={talkCount === 1 ? 'Notiz' : 'Notizen'}
    methodCountLabel={methodCount === 1 ? 'Methode' : 'Methoden'}
    fieldDescription="Praktische Notizen zum Testen und Absichern von KI-Systemen."
    talkDescription="Forschungspapiere erklärt, mit Ergebnissen und Grenzen."
    methodDescription="Wie ich Experimente plane, Papers bewerte und Robustheit teste."
    fieldCta="Feldnotizen ansehen"
    talkCta="Paper-Notizen ansehen"
    methodCta="Methoden ansehen"
  />

  <section class="writing-feature" aria-labelledby="student-paper-heading">
    <header class="section-heading">
      <h2 id="student-paper-heading">Kursarbeit</h2>
      <p>Juni 2026</p>
    </header>
    <div class="note-card-list">
      <NoteCard
        href={`${base}reports/tracing-the-trigger.pdf`}
        index={0}
        prefix="SP"
        kicker="Nicht peer-reviewte Kursarbeit"
        title="Tracing the Trigger: An Evaluation of Foundational Backdoor Attacks in Pre-trained NLP Models"
        description="Eine vierseitige Arbeit für Scientific Writing über NLP-Backdoors, unsichtbare Trigger und ODSB als Risiken in der KI-Lieferkette. Mit einer Audit-Checkliste aus sechs Punkten."
        headingLevel={3}
        tags={['ai-security', 'backdoor-attacks', 'nlp', 'software-supply-chain']}
        cta="PDF öffnen"
        external
      />
    </div>
    <p class="paper-scope">Nicht peer-reviewte Kursarbeit, keine Publikation oder systematische Literaturübersicht. Die ODSB-Ergebnisse stammen aus meinem Projekt vom Juni 2026, nicht aus einem zweiten Experiment oder einer unabhängigen Replikation.</p>
  </section>
</Base>

<style>
  .writing-feature {
    margin-top: 52px;
  }
  .paper-scope {
    max-width: 76ch;
    color: var(--ink-soft);
    line-height: 1.65;
  }
</style>
