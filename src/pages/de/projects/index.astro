---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { isPublishable } from '../../../lib/contentVisibility';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const all = await getCollection('projectsDe');

const groups = new Map<string, typeof all>();
for (const entry of all) {
  const key = entry.id.split('/')[0];
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(entry);
}

const projects = [...groups.entries()]
  .flatMap(([key, entries]) => {
    const lead = entries.find((entry) => entry.data.type === 'project');
    return lead
      && lead.data.type === 'project'
      && isPublishable(lead)
      && lead.data.slug === 'odsb-semantic-backdoors'
      ? [{ key, data: lead.data, sections: entries.length }]
      : [];
  })
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Base
  title="Projekte | Adarsh Sarda"
  description="Fokussiertes KI-Sicherheitsprojekt und technische Fallstudie."
  lang="de"
  wide
>
  <div class="page-head">
    <p class="eyebrow"><span>Index 02</span> / Aktives Forschungsdossier</p>
    <h1>Fallstudie</h1>
    <p>
      Ein fokussiertes Forschungsdossier zu KI-Sicherheit und adversarial Machine Learning,
      inklusive Methode, Evidenz, Fehlversuchen und Grenzen.
    </p>
  </div>

  <div class="project-card-list">
    {projects.map((p, index) => (
      <ProjectCard href={`${base}de/projects/${p.key}/`} index={index} data={p.data} lang="de" />
    ))}
  </div>
</Base>
