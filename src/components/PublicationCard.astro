---
import type { CollectionEntry } from 'astro:content';

type Publication = Extract<CollectionEntry<'profile'>['data'], { type: 'publication' }>;

interface Props {
  publication: Publication;
  index: number;
  lang?: 'en' | 'de';
}

const { publication, index, lang = 'en' } = Astro.props;
const reportedResult = publication.reported_result;
const reportedValue = reportedResult.unit === 'percent'
  ? lang === 'de'
    ? `${reportedResult.value} Prozent`
    : `${reportedResult.value}%`
  : String(reportedResult.value);
const reportedMetric = reportedResult.metric === 'accuracy'
  ? lang === 'de' ? 'Modellgenauigkeit' : 'model accuracy'
  : reportedResult.metric;
const approx = reportedResult.approximate ? (lang === 'de' ? 'rund ' : 'approximately ') : '';
const resultSentence = lang === 'de'
  ? `${publication.summary.de} ${reportedResult.attribution.de} eine ${reportedMetric} von ${approx}${reportedValue}. Der Verlag beschreibt dieses Ergebnis für ${reportedResult.scope.de}; ${reportedResult.caveat.de}`
  : `${publication.summary.en} ${reportedResult.attribution.en} ${approx}${reportedValue} ${reportedMetric}. The publisher describes this result for ${reportedResult.scope.en}; ${reportedResult.caveat.en}`;
const publishedOn = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${publication.published_on}T00:00:00Z`));
const titleId = `publication-${publication.slug}-title`;
const authorSeparator = (authorIndex: number) => {
  if (authorIndex === 0) return '';
  if (authorIndex < publication.authors.length - 1) return ', ';
  if (lang === 'de') return ' und ';
  return publication.authors.length === 2 ? ' and ' : ', and ';
};
---

<article class="publication-card" id={publication.slug} aria-labelledby={titleId}>
  <div class="publication-head">
    <span class="publication-number">P-{String(index + 1).padStart(2, '0')}</span>
    <p class="publication-type">{publication.publication_type[lang]} / {publication.year}</p>
  </div>
  <div class="publication-body">
    <div class="publication-lead">
      <h2 id={titleId}>{publication.title}</h2>
      <p class="publication-authors">
        {publication.authors.map((author, authorIndex) => (
          <>
            {authorSeparator(authorIndex)}
            {author.portfolio_owner
              ? <strong>{author.citation_name}</strong>
              : author.citation_name}
          </>
        ))}
      </p>
    </div>
    <div class="publication-detail">
      <p class="publication-abstract">
        {lang === 'de' ? (
          <>Veröffentlicht in <em>{publication.venue}</em>, {publication.series}, Band {publication.volume},
          Seiten {publication.pages}. Erstveröffentlichung online am {publishedOn}.</>
        ) : (
          <>Published in <em>{publication.venue}</em>, {publication.series}, volume {publication.volume},
          pages {publication.pages}. First published online {publishedOn}.</>
        )}
      </p>
      <p class="publication-abstract">{resultSentence}</p>
      <div class="publication-links">
        <a class="text-link" href={publication.source} target="_blank" rel="noopener noreferrer">
          {publication.publisher} / DOI <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  <dl class="publication-citation">
    <div><dt>DOI</dt><dd>{publication.doi}</dd></div>
    <div><dt>{lang === 'de' ? 'Publikationsort' : 'Venue'}</dt><dd>{publication.venue}</dd></div>
    <div><dt>{lang === 'de' ? 'Reihe' : 'Series'}</dt><dd>{publication.series_abbreviation} {publication.volume}</dd></div>
    <div><dt>{lang === 'de' ? 'Beitrag' : 'Contribution'}</dt><dd>{publication.contribution[lang]}</dd></div>
  </dl>
</article>

<style>
  .publication-card + .publication-card {
    margin-top: 26px;
  }
</style>
