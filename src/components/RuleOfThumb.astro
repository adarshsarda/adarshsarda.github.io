---
// Currently unused. Rendered nowhere by default; drop <RuleOfThumb /> (or
// <RuleOfThumb lang="de" />) into a page section to switch it back on.
interface Props {
  lang?: 'en' | 'de';
}

const { lang = 'en' } = Astro.props;

// Short, sharp rules drawn from the actual work (ODSB, agent security, RAG,
// evaluation). Deliberately distinct from the four Research Principles.
const content = {
  en: {
    kicker: 'Rule of thumb',
    button: 'Show another',
    facts: [
      "A backdoor doesn't need a strange token. Sometimes the trigger is an ordering of meanings, not a keyword.",
      "A model can refuse in words and still act. Audit the side effect, not the sentence.",
      "An attack that never gets retrieved isn't safe. It is only untested at the step that matters.",
      "A success rate without its denominator is a rumor. Put the sample size next to the number.",
      "Citations are a security control only when they stay faithful to the source.",
      "Memory that trusts its input more than its source is privilege escalation waiting to happen.",
    ],
  },
  de: {
    kicker: 'Faustregel',
    button: 'Andere anzeigen',
    facts: [
      "Eine Backdoor braucht kein seltsames Token. Manchmal ist der Trigger eine Reihenfolge von Bedeutungen, kein Keyword.",
      "Ein Modell kann in Worten ablehnen und trotzdem handeln. Prüfe den Seiteneffekt, nicht den Satz.",
      "Ein Angriff, der nie abgerufen wird, ist nicht sicher. Er ist nur am entscheidenden Schritt ungetestet.",
      "Eine Erfolgsrate ohne ihren Nenner ist ein Gerücht. Nenne die Stichprobengröße direkt neben der Zahl.",
      "Zitationen sind nur dann eine Sicherheitskontrolle, wenn sie der Quelle treu bleiben.",
      "Memory, das seinem Input mehr vertraut als seiner Quelle, ist eine Rechteausweitung, die nur auf ihren Moment wartet.",
    ],
  },
} as const;

const copy = content[lang];
---

<aside class="rule-of-thumb-card" data-rule-of-thumb>
  <div class="rule-of-thumb-head">
    <p class="rule-of-thumb-kicker">{copy.kicker}</p>
    <button type="button" class="rule-of-thumb-button" data-rule-of-thumb-next hidden>
      {copy.button} <span aria-hidden="true">↻</span>
    </button>
  </div>
  <p class="rule-of-thumb-text" data-rule-of-thumb-text aria-live="polite">{copy.facts[0]}</p>
  <script type="application/json" data-rule-of-thumb-data set:html={JSON.stringify(copy.facts)}></script>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-rule-of-thumb]').forEach((card) => {
    const textEl = card.querySelector<HTMLElement>('[data-rule-of-thumb-text]');
    const button = card.querySelector<HTMLButtonElement>('[data-rule-of-thumb-next]');
    const dataEl = card.querySelector<HTMLElement>('[data-rule-of-thumb-data]');
    if (!textEl || !button || !dataEl) return;

    let facts: string[] = [];
    try {
      const parsed = JSON.parse(dataEl.textContent || '[]');
      if (Array.isArray(parsed)) facts = parsed.filter((f) => typeof f === 'string');
    } catch {
      facts = [];
    }
    if (facts.length < 2) return;

    let index = Math.floor(Math.random() * facts.length);
    textEl.textContent = facts[index];
    button.hidden = false;

    button.addEventListener('click', () => {
      index = (index + 1) % facts.length;
      textEl.textContent = facts[index];
    });
  });
</script>

<style>
  .rule-of-thumb-card {
    padding: 32px clamp(24px, 4vw, 40px);
    background: var(--paper-raised);
    border-left: 3px solid var(--signal);
  }

  .rule-of-thumb-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .rule-of-thumb-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-dark);
  }

  .rule-of-thumb-button {
    flex: none;
    padding: 7px 12px;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--rule-dark);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  .rule-of-thumb-button:hover {
    color: var(--paper-raised);
    background: var(--moss);
    border-color: var(--moss);
  }

  .rule-of-thumb-button:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .rule-of-thumb-text {
    margin: 0;
    max-width: 56ch;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    line-height: 1.42;
    color: var(--ink);
  }

  @media (max-width: 600px) {
    .rule-of-thumb-card {
      padding: 26px 22px;
    }
  }
</style>
