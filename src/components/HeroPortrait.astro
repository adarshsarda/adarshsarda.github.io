---
interface Props {
  lang?: 'en' | 'de';
  noteLabel?: string;
}

const { lang = 'en', noteLabel } = Astro.props;
const base = import.meta.env.BASE_URL;

const copy = {
  en: {
    noteLabel: 'Current inquiry / 2026',
    aria: 'Portrait of Adarsh Sarda. Use left and right arrow keys to switch portrait theme.',
    portraits: [
      {
        id: 'studio',
        src: `${base}images/portrait-professional.png`,
        alt: 'Professional portrait of Adarsh Sarda in a dark suit jacket',
        meta: 'M.Sc. Artificial Intelligence',
      },
      {
        id: 'outdoor',
        src: `${base}images/portrait.jpeg`,
        alt: 'Portrait outdoors beside a river',
        meta: 'Research notes / AI security',
      },
    ],
  },
  de: {
    noteLabel: 'Aktuelle Frage / 2026',
    aria: 'Portraet von Adarsh Sarda. Mit linker und rechter Pfeiltaste das Portraet-Theme wechseln.',
    portraits: [
      {
        id: 'studio',
        src: `${base}images/portrait-professional.png`,
        alt: 'Professionelles Portraet von Adarsh Sarda im dunklen Sakko',
        meta: 'M.Sc. Artificial Intelligence',
      },
      {
        id: 'outdoor',
        src: `${base}images/portrait.jpeg`,
        alt: 'Portraet im Freien neben einem Fluss',
        meta: 'Forschungsnotizen / KI-Sicherheit',
      },
    ],
  },
} as const;

const t = copy[lang];
const defaultPortrait = t.portraits[0];
const payload = {
  portraits: t.portraits,
  storageKey: 'portraitTheme',
};
---

<figure
  class="hero-portrait"
  data-portrait-switcher
  tabindex="0"
  aria-label={t.aria}
>
  <div class="portrait-frame" data-portrait-frame>
    <img
      src={defaultPortrait.src}
      alt={defaultPortrait.alt}
      width="666"
      height="720"
      loading="eager"
      fetchpriority="high"
      data-portrait-image
    />
  </div>
  <figcaption class="portrait-caption">
    <span data-portrait-caption-name>Adarsh Sarda</span>
    <span data-portrait-caption-meta>{defaultPortrait.meta}</span>
  </figcaption>
  <div class="portrait-note">
    <p class="note-label">{noteLabel ?? t.noteLabel}</p>
    <slot />
  </div>
  <script
    type="application/json"
    data-portrait-data
    set:html={JSON.stringify(payload).replaceAll('<', '\\u003c')}
  ></script>
</figure>

<script>
  type Portrait = {
    id: string;
    src: string;
    alt: string;
    meta: string;
  };

  type PortraitPayload = {
    portraits: Portrait[];
    storageKey: string;
  };

  const portraitSwitchers = document.querySelectorAll<HTMLElement>('[data-portrait-switcher]');
  const reducePortraitMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  portraitSwitchers.forEach((switcher) => {
    const image = switcher.querySelector<HTMLImageElement>('[data-portrait-image]');
    const meta = switcher.querySelector<HTMLElement>('[data-portrait-caption-meta]');
    const dataEl = switcher.querySelector<HTMLElement>('[data-portrait-data]');
    if (!image || !meta || !dataEl) return;

    let payload: PortraitPayload = { portraits: [], storageKey: 'portraitTheme' };
    try {
      payload = { ...payload, ...JSON.parse(dataEl.textContent || '{}') };
    } catch {
      // Keep the safe defaults.
    }

    if (payload.portraits.length < 2) return;

    const getStoredTheme = () => {
      try {
        return sessionStorage.getItem(payload.storageKey);
      } catch {
        return null;
      }
    };

    const storeTheme = (theme: string) => {
      try {
        sessionStorage.setItem(payload.storageKey, theme);
      } catch {
        // Session persistence is optional.
      }
    };

    let index = Math.max(
      0,
      payload.portraits.findIndex((portrait) => portrait.id === getStoredTheme()),
    );

    const applyPortrait = (nextIndex: number, persist = false) => {
      index = (nextIndex + payload.portraits.length) % payload.portraits.length;
      const portrait = payload.portraits[index];
      document.documentElement.dataset.portraitTheme = portrait.id;
      if (persist) storeTheme(portrait.id);

      if (reducePortraitMotion.matches) {
        image.src = portrait.src;
        image.alt = portrait.alt;
        meta.textContent = portrait.meta;
        return;
      }

      image.classList.add('is-switching');
      window.setTimeout(() => {
        image.src = portrait.src;
        image.alt = portrait.alt;
        meta.textContent = portrait.meta;
        image.classList.remove('is-switching');
      }, 120);
    };

    applyPortrait(index);

    const move = (direction: number) => applyPortrait(index + direction, true);

    let startX = 0;
    let startY = 0;
    let dragging = false;

    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        move(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        move(1);
      }
    });

    switcher.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
      startY = event.clientY;
      dragging = true;
    });

    switcher.addEventListener('pointerup', (event) => {
      if (!dragging) return;
      dragging = false;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) < 55 || Math.abs(dx) <= Math.abs(dy) * 1.2) return;
      move(dx < 0 ? 1 : -1);
    });

    switcher.addEventListener('pointercancel', () => {
      dragging = false;
    });

    switcher.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaX) < 35 || Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
      event.preventDefault();
      move(event.deltaX > 0 ? 1 : -1);
    }, { passive: false });
  });
</script>
