---
import { getCollection } from 'astro:content';
import { isPublicProject, isPublishable } from '../lib/contentVisibility';
import { CANARY } from '../lib/canary';

interface Props {
  lang?: 'en' | 'de';
}

const { lang = 'en' } = Astro.props;
const prefix = lang === 'de' ? '/de' : '';
const collectionNames = lang === 'de'
  ? {
      projects: 'projectsDe' as const,
      guides: 'guidesDe' as const,
      talks: 'talksDe' as const,
      methods: 'methodsDe' as const,
    }
  : {
      projects: 'projects' as const,
      guides: 'guides' as const,
      talks: 'talks' as const,
      methods: 'methods' as const,
    };

const [projectCollection, guideCollection, talkCollection, methodCollection, profileCollection] = await Promise.all([
  getCollection(collectionNames.projects),
  getCollection(collectionNames.guides),
  getCollection(collectionNames.talks),
  getCollection(collectionNames.methods),
  getCollection('profile'),
]);

// Everything the terminal prints is derived from real content. No invented
// counts, no fabricated findings.
const projectEntries = projectCollection.flatMap((entry) =>
  entry.data.type === 'project' && isPublicProject(entry)
    ? [{
        slug: entry.data.slug ?? entry.id,
        title: entry.data.title ?? entry.id,
        status: entry.data.status ?? 'documented',
        context: entry.data.context ?? '',
        submissionDate: entry.data.submission_date,
      }]
    : [],
);
const visibleGuides = guideCollection.filter(isPublishable);
const visibleTalks = talkCollection.filter(isPublishable);
const guideCount = visibleGuides.length;
const talkCount = visibleTalks.length;
const methodCount = methodCollection.length;
const publicationEntries = profileCollection
  .flatMap((entry) => entry.data.type === 'publication' ? [entry.data] : [])
  .sort((a, b) => b.published_on.localeCompare(a.published_on));
const publicationCount = publicationEntries.length;
type Publication = (typeof publicationEntries)[number];
const publicationVenue = (publication: Publication) =>
  `${publication.publisher}, ${publication.venue}, ` +
  `${publication.series_abbreviation} ${publication.volume} (${publication.year})`;
const publicationContribution = (publication: Publication, locale: 'en' | 'de') => {
  const ownerPosition = publication.authors.findIndex((author) => author.portfolio_owner) + 1;
  return locale === 'de'
    ? `${publication.contribution.de}; ${ownerPosition}. von ${publication.authors.length} Autoren.`
    : `${publication.contribution.en}; ${ownerPosition} of ${publication.authors.length} authors.`;
};
const publicationLines = (locale: 'en' | 'de') => publicationEntries.flatMap((publication) => [
  `  ${publication.title}`,
  `    ${publicationVenue(publication)}`,
  `    ${publicationContribution(publication, locale)}`,
  `    DOI: https://doi.org/${publication.doi}`,
  `    ${prefix}/publications/#${publication.slug}`,
]);
const publicationTimelineLines = (locale: 'en' | 'de') => [...publicationEntries]
  .sort((a, b) => a.year - b.year)
  .map((publication) =>
    `${publication.year}  ${publication.publication_type[locale]}, ${publicationContribution(publication, locale)}`,
  );
const publicationLabelEn = publicationCount === 1 ? 'publication' : 'publications';
const publicationLabelDe = publicationCount === 1 ? 'Publikation' : 'Publikationen';
const odsbSubmission = projectEntries
  .find((project) => project.slug === 'odsb-semantic-backdoors')
  ?.submissionDate
  ?.toISOString()
  .slice(0, 10) ?? '2026';

const projectLines = projectEntries.flatMap((project) => [
  `  ${project.title}`,
  `    Status: ${project.status}`,
  ...(project.context ? [`    Type: ${project.context}`] : []),
  '    Review status: not peer reviewed',
  `    ${prefix}/projects/${project.slug}/`,
]);

const copy = {
  en: {
    title: 'adarsh.sarda : portfolio shell',
    close: 'Close terminal',
    prompt: '$',
    label: 'Terminal',
    banner: [
      'adarsh.sarda : portfolio shell',
      'Type help for commands. Esc closes.',
    ],
    notFound: 'command not found: {cmd}. Type help.',
    aliases: {
      about: 'whoami',
      notes: 'writing',
      pubs: 'publications',
      cv: 'timeline',
      quit: 'exit',
      ls: 'help',
    },
    commands: {
      help: [
        'COMMAND          DESCRIPTION',
        'whoami           profile and current focus',
        'projects         documented research case files',
        'publications     peer-reviewed work',
        'writing          field notes, talk notes, and methods',
        'skills           skills and evidence',
        'timeline         academic and professional path',
        'contact          ways to reach me',
        'canary           inspect the canary marker',
        'coffee           ?',
        'clear            clear the screen',
        'exit             close this terminal',
      ],
      whoami: [
        'Adarsh Sarda',
        'AI security researcher and M.Sc. student.',
        'Current public work focuses on LLM backdoors, data poisoning,',
        'and the evaluation methods that catch them.',
        'Based in Amberg, Germany.',
      ],
      projects: [
        `${projectEntries.length} case file${projectEntries.length === 1 ? '' : 's'}:`,
        ...projectLines,
      ],
      publications: [
        `${publicationCount} peer-reviewed ${publicationLabelEn}:`,
        ...publicationLines('en'),
      ],
      writing: [
        `${guideCount} field notes, ${talkCount} talk notes, ${methodCount} methods.`,
        `  ${prefix}/notes/    writing index`,
        `  ${prefix}/guides/   long-form methodology and checklists`,
        `  ${prefix}/talks/    notes on papers and talks`,
        `  ${prefix}/methods/  research and evaluation methods`,
      ],
      skills: [
        'Proficiency is evidenced, not aspirational:',
        '  proficient  demonstrated in a completed, evidenced project',
        '  working     used substantively with a concrete artifact',
        '  familiar    applied at a smaller scale or in coursework',
        `  ${prefix}/skills/`,
      ],
      timeline: [
        '2019  B.Tech Information Technology, IEM Kolkata (to 2023)',
        ...publicationTimelineLines('en'),
        '2023  AI Research Analyst, GreyB Research (to 2024)',
        '2025  M.Sc. AI for Industrial Applications, OTH Amberg-Weiden',
        `${odsbSubmission}  ODSB submitted: order-dependent semantic backdoors`,
      ],
      contact: [
        'Email: mailto:adarshsarda29@gmail.com',
        'LinkedIn: https://www.linkedin.com/in/adarshsarda',
        'GitHub: https://github.com/adarshsarda/',
      ],
      canary: [
        CANARY,
        '',
        'A canary string is a unique marker planted in data, a prompt, or a',
        'document so you can later detect whether it leaked, was memorised,',
        'or was exfiltrated.',
        '',
        'This one is inert. It is a nod to my backdoor and evaluation work,',
        'not a live detector. Nothing here is watching you.',
      ],
      coffee: [
        '418 I am a teapot.',
        'Dependency acknowledged. Never measured, so never reported.',
      ],
    },
  },
  de: {
    title: 'adarsh.sarda : Portfolio-Shell',
    close: 'Terminal schließen',
    prompt: '$',
    label: 'Terminal',
    banner: [
      'adarsh.sarda : Portfolio-Shell',
      'Tippe help für Befehle. Esc schließt.',
    ],
    notFound: 'Befehl nicht gefunden: {cmd}. Tippe help.',
    aliases: {
      about: 'whoami',
      projekte: 'projects',
      publikationen: 'publications',
      texte: 'writing',
      notes: 'writing',
      kenntnisse: 'skills',
      werdegang: 'timeline',
      pubs: 'publications',
      cv: 'timeline',
      quit: 'exit',
      ls: 'help',
    },
    commands: {
      help: [
        'BEFEHL           BESCHREIBUNG',
        'whoami           Profil und aktueller Fokus',
        'projects         dokumentierte Forschungs-Fallstudien',
        'publications     begutachtete Arbeiten',
        'writing          Feldnotizen, Talk-Notizen und Methoden',
        'skills           Skills und Evidenz',
        'timeline         akademischer und beruflicher Weg',
        'contact          Kontaktwege',
        'canary           Canary-Marker ansehen',
        'coffee           ?',
        'clear            Bildschirm leeren',
        'exit             Terminal schließen',
      ],
      whoami: [
        'Adarsh Sarda',
        'KI-Sicherheitsforscher und M.Sc.-Student.',
        'Meine öffentliche Arbeit konzentriert sich auf LLM-Backdoors,',
        'Data Poisoning und Evaluationsmethoden, die sie aufdecken.',
        'Ansässig in Amberg, Deutschland.',
      ],
      projects: [
        `${projectEntries.length} Fallstudie${projectEntries.length === 1 ? '' : 'n'}:`,
        ...projectLines,
      ],
      publications: [
        `${publicationCount} begutachtete ${publicationLabelDe}:`,
        ...publicationLines('de'),
      ],
      writing: [
        `${guideCount} Feldnotizen, ${talkCount} Talk-Notizen, ${methodCount} Methoden.`,
        `  ${prefix}/notes/    Text-Index`,
        `  ${prefix}/guides/   ausführliche Methodik und Checklisten`,
        `  ${prefix}/talks/    Notizen zu Papers und Vorträgen`,
        `  ${prefix}/methods/  Forschungs- und Evaluationsmethoden`,
      ],
      skills: [
        'Proficiency ist belegt, nicht angestrebt:',
        '  proficient  in einem abgeschlossenen, belegten Projekt gezeigt',
        '  working     substanziell genutzt, mit konkretem Artefakt',
        '  familiar    in kleinerem Rahmen oder im Studium angewendet',
        `  ${prefix}/skills/`,
      ],
      timeline: [
        '2019  B.Tech Informationstechnologie, IEM Kolkata (bis 2023)',
        ...publicationTimelineLines('de'),
        '2023  AI Research Analyst, GreyB Research (bis 2024)',
        '2025  M.Sc. KI für industrielle Anwendungen, OTH Amberg-Weiden',
        `${odsbSubmission}  ODSB eingereicht: reihenfolgeabhängige semantische Backdoors`,
      ],
      contact: [
        'Email: mailto:adarshsarda29@gmail.com',
        'LinkedIn: https://www.linkedin.com/in/adarshsarda',
        'GitHub: https://github.com/adarshsarda/',
      ],
      canary: [
        CANARY,
        '',
        'Ein Canary-String ist ein eindeutiger Marker in Daten, einem Prompt',
        'oder einem Dokument, mit dem sich später feststellen lässt, ob er',
        'geleakt, memorisiert oder exfiltriert wurde.',
        '',
        'Dieser hier ist inert. Er ist eine Anspielung auf meine Arbeit zu',
        'Backdoors und Evaluation, kein aktiver Detektor. Hier beobachtet',
        'dich nichts.',
      ],
      coffee: [
        '418 Ich bin eine Teekanne.',
        'Abhängigkeit eingeräumt. Nie gemessen, also nie berichtet.',
      ],
    },
  },
} as const;

const t = copy[lang];
const payload = {
  prompt: t.prompt,
  banner: t.banner,
  notFound: t.notFound,
  aliases: t.aliases,
  commands: t.commands,
};
---

<dialog class="terminal" data-terminal aria-label={t.label}>
  <div class="terminal-bar">
    <span class="terminal-title">{t.title}</span>
    <button type="button" class="terminal-close" data-terminal-close aria-label={t.close}>&times;</button>
  </div>
  <div class="terminal-output" data-terminal-output role="log" aria-live="polite"></div>
  <form class="terminal-form" data-terminal-form>
    <label class="terminal-prompt" for="terminal-input" aria-hidden="true">{t.prompt}</label>
    <input
      id="terminal-input"
      class="terminal-input"
      data-terminal-input
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label={t.label}
    />
  </form>
  <script
    is:inline
    type="application/json"
    data-terminal-data
    set:html={JSON.stringify(payload).replaceAll('<', '\\u003c')}
  ></script>
</dialog>

<script>
  type TerminalData = {
    prompt: string;
    banner: string[];
    notFound: string;
    aliases: Record<string, string>;
    commands: Record<string, string[]>;
  };

  const term = document.querySelector<HTMLDialogElement>('[data-terminal]');
  if (term) {
    const output = term.querySelector<HTMLElement>('[data-terminal-output]');
    const form = term.querySelector<HTMLFormElement>('[data-terminal-form]');
    const input = term.querySelector<HTMLInputElement>('[data-terminal-input]');
    const dataEl = term.querySelector<HTMLElement>('[data-terminal-data]');

    if (output && form && input && dataEl) {
      let data: TerminalData = {
        prompt: '$',
        banner: [],
        notFound: '',
        aliases: {},
        commands: {},
      };
      try {
        data = { ...data, ...JSON.parse(dataEl.textContent || '{}') };
      } catch {
        // Keep the safe defaults.
      }

      const linkPattern = /((?:https?:\/\/|mailto:|\/)[^\s]+)/;
      const appendLine = (el: HTMLElement, line: string) => {
        if (line === '') {
          el.textContent = '\u00a0';
          return;
        }

        const match = line.match(linkPattern);
        if (!match || match.index === undefined) {
          el.textContent = line;
          return;
        }

        const href = match[0];
        const link = document.createElement('a');
        link.href = href;
        link.textContent = href;
        if (href.startsWith('http')) {
          link.target = '_blank';
          link.rel = 'noreferrer';
        }

        el.append(
          document.createTextNode(line.slice(0, match.index)),
          link,
          document.createTextNode(line.slice(match.index + href.length)),
        );
      };

      const print = (lines: string[], variant?: string) => {
        for (const line of lines) {
          const el = document.createElement('div');
          el.className = variant ? `terminal-line ${variant}` : 'terminal-line';
          appendLine(el, line);
          output.appendChild(el);
        }
        output.scrollTop = output.scrollHeight;
      };

      const resolveCommand = (raw: string) => {
        const cmd = raw.trim().toLowerCase();
        return data.aliases[cmd] ?? cmd;
      };

      const run = (raw: string) => {
        const typed = raw.trim();
        if (!typed) return;
        const cmd = resolveCommand(typed);
        print([`${data.prompt} ${typed}`], 'terminal-echo');
        if (cmd === 'clear') {
          output.replaceChildren();
          return;
        }
        if (cmd === 'exit') {
          term.close();
          return;
        }
        const lines = data.commands[cmd];
        if (lines) print(lines);
        else print([data.notFound.replace('{cmd}', typed.toLowerCase())], 'terminal-error');
      };

      const history: string[] = [];
      let historyIndex = 0;
      const commands = () =>
        [...new Set([...Object.keys(data.commands), ...Object.keys(data.aliases)])].sort();

      const submitCommand = () => {
        const value = input.value.trim();
        if (value) {
          history.push(value);
          historyIndex = history.length;
        }
        run(value);
        input.value = '';
      };

      let bannerShown = false;
      const open = (initial?: string) => {
        if (!term.open) {
          if (!bannerShown) {
            print(data.banner, 'terminal-banner');
            bannerShown = true;
          }
          term.showModal();
        }
        if (initial) run(initial);
        input.focus();
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        submitCommand();
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          submitCommand();
          return;
        }
        if (event.key === 'Escape') {
          event.preventDefault();
          term.close();
          return;
        }
        if (event.key === 'ArrowUp') {
          if (history.length) {
            event.preventDefault();
            historyIndex = Math.max(0, historyIndex - 1);
            input.value = history[historyIndex] ?? '';
          }
          return;
        }
        if (event.key === 'ArrowDown') {
          if (history.length) {
            event.preventDefault();
            historyIndex = Math.min(history.length, historyIndex + 1);
            input.value = history[historyIndex] ?? '';
          }
          return;
        }
        if (event.key === 'Tab') {
          const current = input.value.trim().toLowerCase();
          if (current && !current.includes(' ')) {
            const match = commands().find((command) => command.startsWith(current));
            if (match) {
              event.preventDefault();
              input.value = match;
            }
          }
        }
      });

      term.querySelector<HTMLButtonElement>('[data-terminal-close]')
        ?.addEventListener('click', () => term.close());

      // Backtick toggles the terminal, but never while the visitor is typing
      // (the talk index has a live search field).
      document.addEventListener('keydown', (event) => {
        if (event.key !== '`' || event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target as HTMLElement | null;
        if (target?.closest('input, textarea, select, [contenteditable="true"]')) return;
        event.preventDefault();
        if (term.open) term.close();
        else open();
      });

      // The footer canary opens the terminal on the canary entry. This is also
      // the way in on touch devices, where there is no backtick key.
      document.querySelectorAll<HTMLElement>('[data-terminal-canary]').forEach((el) => {
        el.addEventListener('click', () => open('canary'));
      });
    }
  }
</script>

<style>
  .terminal {
    width: min(720px, calc(100vw - 28px));
    max-height: min(70vh, 560px);
    padding: 0;
    color: var(--paper-raised);
    background: var(--ink);
    border: 1px solid var(--rule-dark);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .terminal[open] {
    display: flex;
    flex-direction: column;
  }

  .terminal::backdrop {
    background: color-mix(in srgb, #050807 72%, transparent);
  }

  .terminal-bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--paper-raised) 20%, transparent);
  }

  .terminal-title {
    color: color-mix(in srgb, var(--paper-raised) 66%, transparent);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .terminal-close {
    min-width: 44px;
    min-height: 44px;
    padding: 0 4px;
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--paper-raised) 70%, transparent);
    background: transparent;
    border: 0;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .terminal-close:hover {
    color: var(--paper-raised);
  }

  .terminal-close:focus-visible,
  .terminal-input:focus-visible {
    outline: 2px solid var(--stone);
    outline-offset: 2px;
  }

  .terminal-output {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px;
  }

  .terminal-line {
    margin: 0;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal-line a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--stone) 72%, transparent);
    text-underline-offset: 3px;
  }

  .terminal-line a:hover {
    color: var(--stone);
  }

  .terminal-line a:focus-visible {
    outline: 2px solid var(--stone);
    outline-offset: 2px;
  }

  .terminal-banner {
    color: color-mix(in srgb, var(--paper-raised) 62%, transparent);
  }

  .terminal-echo {
    color: var(--stone);
  }

  .terminal-error {
    color: color-mix(in srgb, var(--signal) 32%, var(--paper-raised));
  }

  .terminal-form {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-top: 1px solid color-mix(in srgb, var(--paper-raised) 20%, transparent);
  }

  .terminal-prompt {
    color: var(--stone);
  }

  .terminal-input {
    flex: 1;
    min-width: 0;
    color: inherit;
    background: transparent;
    border: 0;
    font: inherit;
  }

  .terminal-input:focus:not(:focus-visible) {
    outline: none;
  }

  @media (max-width: 600px) {
    .terminal {
      font-size: 0.74rem;
      max-height: 76vh;
    }
  }
</style>
