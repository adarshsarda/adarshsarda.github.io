---
interface Props {
  guideCount: number;
  talkCount: number;
  methodCount: number;
  fieldHref: string;
  talkHref: string;
  methodHref: string;
  fieldCountLabel: string;
  talkCountLabel: string;
  methodCountLabel: string;
  fieldDescription: string;
  talkDescription: string;
  methodDescription: string;
  fieldCta: string;
  talkCta: string;
  methodCta: string;
  fieldTitle?: string;
  talkTitle?: string;
  methodTitle?: string;
}

const {
  guideCount,
  talkCount,
  methodCount,
  fieldHref,
  talkHref,
  methodHref,
  fieldCountLabel,
  talkCountLabel,
  methodCountLabel,
  fieldDescription,
  talkDescription,
  methodDescription,
  fieldCta,
  talkCta,
  methodCta,
  fieldTitle = 'Guides',
  talkTitle = 'Paper notes',
  methodTitle = 'Methods',
} = Astro.props;
---

<div class="notes-hub">
  <a class="notes-hub-card notes-hub-card--field" href={fieldHref}>
    <div class="notes-hub-top">
      <span class="notes-hub-count">{guideCount} {fieldCountLabel}</span>
    </div>
    <h2>{fieldTitle}</h2>
    <p>{fieldDescription}</p>
    <span class="notes-hub-cta">{fieldCta} <span aria-hidden="true">→</span></span>
  </a>

  <a class="notes-hub-card notes-hub-card--talk" href={talkHref}>
    <div class="notes-hub-top">
      <span class="notes-hub-count">{talkCount} {talkCountLabel}</span>
    </div>
    <h2>{talkTitle}</h2>
    <p>{talkDescription}</p>
    <span class="notes-hub-cta">{talkCta} <span aria-hidden="true">→</span></span>
  </a>

  <a class="notes-hub-card notes-hub-card--method" href={methodHref}>
    <div class="notes-hub-top">
      <span class="notes-hub-count">{methodCount} {methodCountLabel}</span>
    </div>
    <h2>{methodTitle}</h2>
    <p>{methodDescription}</p>
    <span class="notes-hub-cta">{methodCta} <span aria-hidden="true">→</span></span>
  </a>
</div>

<style>
  .notes-hub {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .notes-hub-card {
    display: flex;
    flex-direction: column;
    min-height: 180px;
    padding: 24px;
    color: var(--paper-raised);
    text-decoration: none;
  }

  .notes-hub-card--field {
    background: var(--signal);
  }

  .notes-hub-card--talk {
    background: var(--moss);
  }

  .notes-hub-card--method {
    background: var(--ink);
  }

  .notes-hub-card:hover {
    outline: 2px solid var(--signal-dark);
    outline-offset: 3px;
  }

  .notes-hub-top {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
  }

  .notes-hub-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .notes-hub-card h2 {
    margin: 16px 0 12px;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .notes-hub-card > p {
    margin: 0;
    max-width: 38ch;
    font-size: 0.95rem;
    line-height: 1.55;
    opacity: 0.88;
  }

  .notes-hub-cta {
    margin-top: auto;
    padding-top: 26px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .notes-hub-card:hover .notes-hub-cta {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .notes-hub {
      grid-template-columns: 1fr;
    }

    .notes-hub-card {
      min-height: 180px;
    }
  }

</style>
