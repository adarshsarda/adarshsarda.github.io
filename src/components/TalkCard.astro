---
import type { CollectionEntry } from 'astro:content';

type TalkEntry = CollectionEntry<'talks'> | CollectionEntry<'talksDe'>;

interface Props {
  entry: TalkEntry;
  index: number;
  hrefPrefix?: string;
  lang?: 'en' | 'de';
  headingLevel?: 2 | 3;
}

const { entry, index, hrefPrefix = '/talks', lang = 'en', headingLevel = 2 } = Astro.props;
const { data } = entry;
const href = `${hrefPrefix}/${entry.id}/`;
const difficultyLabels: Record<string, Record<string, string>> = {
  en: { Beginner: 'Beginner', Intermediate: 'Intermediate', Advanced: 'Advanced' },
  de: { Beginner: 'Einsteiger', Intermediate: 'Mittel', Advanced: 'Fortgeschritten' },
};
const formatLabels: Record<string, Record<string, string>> = {
  en: {
    'Paper presentation': 'Paper presentation',
    'Paper explainer': 'Paper note',
    'Original research talk': 'Original research talk',
    Workshop: 'Workshop',
  },
  de: {
    'Paper presentation': 'Paper-Präsentation',
    'Paper explainer': 'Paper-Notiz',
    'Original research talk': 'Originalforschungs-Talk',
    Workshop: 'Workshop',
  },
};
const readLabel = lang === 'de' ? 'Notiz lesen' : 'Read note';
---

<a class="talk-card" href={href}>
  <div class="talk-card-top">
    <span class="talk-number">T-{String(index + 1).padStart(2, '0')}</span>
    <div class="badges" role="group" aria-label={lang === 'de' ? 'Metadaten' : 'Note metadata'}>
      <span>{difficultyLabels[lang][data.difficulty] ?? data.difficulty}</span>
      <span>{formatLabels[lang][data.format] ?? data.format}</span>
    </div>
  </div>

  <p class="talk-source">{data.speaker} / {data.source} / {data.year}</p>
  {headingLevel === 3
    ? <h3>{data.title}</h3>
    : <h2>{data.title}</h2>}
  <p class="talk-summary">{data.description}</p>

  {data.tags && data.tags.length > 0 && (
    <ul class="talk-tags" aria-label={lang === 'de' ? 'Themen' : 'Topics'}>
      {data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
    </ul>
  )}

  <div class="talk-card-actions">
    <span class="note-link">
      {readLabel} <span aria-hidden="true">→</span>
    </span>
  </div>
</a>

<style>
  .talk-card {
    min-height: 100%;
    padding: 24px;
    display: flex;
    flex-direction: column;
    color: var(--paper-raised);
    background: var(--moss);
    border: 1px solid var(--moss);
    text-decoration: none;
  }

  .talk-card:hover {
    color: var(--paper-raised);
    border-color: var(--signal-dark);
  }

  .talk-card:hover .note-link {
    color: #f0cbd4;
    border-color: #f0cbd4;
  }

  .talk-card-top,
  .talk-card-actions {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
  }

  .talk-number,
  .talk-source,
  .badges span,
  .talk-tags,
  .note-link {
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .talk-number {
    color: #e2b9c3;
    font-size: 0.75rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }

  .badges span {
    padding: 3px 7px;
    color: #dbe3de;
    border: 1px solid #71847a;
    font-size: 0.75rem;
  }

  .talk-source {
    margin: 20px 0 8px;
    color: #c7d7cf;
    font-size: 0.75rem;
  }

  :is(h2, h3) {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .talk-summary {
    margin: 17px 0 0;
    color: #dbe3de;
    font-size: 0.91rem;
    line-height: 1.58;
  }

  .talk-tags {
    margin: 18px 0 24px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    color: #c7d7cf;
    font-size: 0.75rem;
    list-style: none;
  }

  .talk-tags li::before {
    content: "/";
    margin-right: 4px;
    color: #e2b9c3;
  }

  .talk-card-actions {
    margin-top: auto;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .note-link {
    padding-bottom: 3px;
    color: var(--paper-raised);
    border-bottom: 1px solid var(--paper-raised);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }
</style>
