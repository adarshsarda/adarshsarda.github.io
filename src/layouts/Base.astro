---
import '../styles/global.css';
import KeyboardControls from '../components/KeyboardControls.astro';
import Terminal from '../components/Terminal.astro';
import { CANARY } from '../lib/canary';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  type?: 'website' | 'article';
  image?: string;
  structuredData?: Record<string, unknown>;
  lang?: 'en' | 'de';
  alternatePath?: string;
  /** Override both language targets for pages with no localized twin (404). */
  langPaths?: { en: string; de: string };
  /** Show the reading progress bar. Defaults to on for article pages. */
  progress?: boolean;
  /** Ask search engines not to index this page (used by 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  wide = false,
  type = 'website',
  image = '/images/og-cover.png',
  structuredData,
  lang = 'en',
  alternatePath,
  langPaths,
  progress,
  noindex = false,
} = Astro.props;
const showProgress = progress ?? type === 'article';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const site = Astro.site ?? Astro.url.origin;
const canonical = new URL(path, site);
const socialImage = new URL(image, site);
const i18n = {
  en: {
    skip: 'Skip to main content',
    navLabel: 'Primary navigation',
    home: '',
    about: 'about/',
    projects: 'projects/',
    notes: 'notes/',
    publications: 'publications/',
    skills: 'skills/',
    cv: 'cv/',
    labels: ['About', 'Projects', 'Writing', 'Publications', 'Skills', 'CV'],
    shortLabels: ['About', 'Work', 'Writing', 'Pubs', 'Skills', 'CV'],
    more: [
      { href: 'methods/', label: 'Methods' },
    ],
  },
  de: {
    skip: 'Zum Hauptinhalt springen',
    navLabel: 'Hauptnavigation',
    home: 'de/',
    about: 'de/about/',
    projects: 'de/projects/',
    notes: 'de/notes/',
    publications: 'de/publications/',
    skills: 'de/skills/',
    cv: 'de/cv/',
    labels: ['Über mich', 'Projekte', 'Texte', 'Publikationen', 'Skills', 'Lebenslauf'],
    shortLabels: ['Profil', 'Projekte', 'Texte', 'Publ.', 'Skills', 'CV'],
    more: [
      { href: 'de/methods/', label: 'Methoden' },
    ],
  },
} as const;
const copy = i18n[lang];
const defaultAlternatePath = lang === 'de'
  ? path.replace(/^\/de(?=\/|$)/, '') || '/'
  : (path === '/' ? '/de/' : `/de${path}`);
const resolvedAlternatePath = alternatePath ?? defaultAlternatePath;
const enPath = langPaths?.en ?? (lang === 'en' ? path : resolvedAlternatePath);
const dePath = langPaths?.de ?? (lang === 'de' ? path : resolvedAlternatePath);
const langAlternates = [
  { lang: 'en', path: enPath },
  { lang: 'de', path: dePath },
];
const isActive = (targets: string[]) => targets.some((target) => path === target || path.startsWith(target));
const aboutActive = isActive(['/about/', '/de/about/']);
const projectsActive = isActive(['/projects/', '/de/projects/']);
const notesActive = isActive(['/notes/', '/guides/', '/talks/', '/de/notes/', '/de/guides/', '/de/talks/']);
const publicationsActive = isActive(['/publications/', '/de/publications/']);
const skillsActive = isActive(['/skills/', '/de/skills/']);
const cvActive = isActive(['/cv/', '/de/cv/']);
const navItems = [
  { number: '01', label: copy.labels[0], shortLabel: copy.shortLabels[0], href: copy.about, active: aboutActive },
  { number: '02', label: copy.labels[1], shortLabel: copy.shortLabels[1], href: copy.projects, active: projectsActive },
  { number: '03', label: copy.labels[2], shortLabel: copy.shortLabels[2], href: copy.notes, active: notesActive },
  { number: '04', label: copy.labels[3], shortLabel: copy.shortLabels[3], href: copy.publications, active: publicationsActive },
  { number: '05', label: copy.labels[4], shortLabel: copy.shortLabels[4], href: copy.skills, active: skillsActive },
  { number: '06', label: copy.labels[5], shortLabel: copy.shortLabels[5], href: copy.cv, active: cvActive },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}#person`,
      name: 'Adarsh Sarda',
      url: site.toString(),
      image: new URL('/images/portrait.jpeg', site).toString(),
      email: 'mailto:adarshsarda29@gmail.com',
      sameAs: [
        'https://www.linkedin.com/in/adarshsarda',
        'https://github.com/adarshsarda/',
      ],
      jobTitle: 'AI security researcher and engineer',
      homeLocation: {
        '@type': 'Place',
        name: 'Amberg, Germany',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      name: 'Adarsh Sarda',
      url: site.toString(),
      description: 'Research and field notes on AI security, LLM red teaming, and adversarial machine learning.',
      author: { '@id': `${site}#person` },
    },
    ...(structuredData ? [structuredData] : []),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {langAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.path, site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Adarsh Sarda" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Adarsh Sarda — AI Security Researcher" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
    <noscript><style is:inline>.reveal,.reveal-stagger>*{opacity:1 !important;transform:none !important}</style></noscript>
  </head>
  <body>
    {showProgress && (
      <div class="reading-progress" aria-hidden="true"><span class="reading-progress-bar" data-reading-progress></span></div>
    )}
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <header class="site-header">
      <div class="bar">
        <a href={`${base}${copy.home}`} class="brand" aria-label="Adarsh Sarda, home">
          <span class="brand-mark" aria-hidden="true">AS</span>
        </a>
        <div class="header-links">
          <nav aria-label={copy.navLabel}>
            {navItems.map((item) => (
              <a href={`${base}${item.href}`} class={item.active ? 'active' : undefined} aria-current={item.active ? 'page' : undefined} aria-label={item.label}>
                <span class="nav-number" aria-hidden="true">{item.number}</span>
                <span class="nav-label-full" aria-hidden="true">{item.label}</span>
                <span class="nav-label-short" aria-hidden="true">{item.shortLabel}</span>
              </a>
            ))}
          </nav>
          <nav class="language-switch" aria-label="Language switcher">
            <a href={new URL(enPath, site).pathname} class={lang === 'en' ? 'active' : undefined} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <span aria-hidden="true">·</span>
            <a href={new URL(dePath, site).pathname} class={lang === 'de' ? 'active' : undefined} aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content" class={wide ? 'container wide' : 'container'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container wide">
        <div class="footer-identity">
          <p>© {year} Adarsh Sarda</p>
          <button type="button" class="canary" data-terminal-canary>{CANARY}</button>
        </div>
        <div class="footer-groups">
          <nav class="footer-links" aria-label={lang === 'de' ? 'Weitere Seiten' : 'More pages'}>
            {copy.more.map((item) => (
              <a href={`${base}${item.href}`}>{item.label}</a>
            ))}
          </nav>
          <div class="footer-links">
            <a href="mailto:adarshsarda29@gmail.com">{lang === 'de' ? 'E-Mail' : 'Email'}</a>
            <a href="https://www.linkedin.com/in/adarshsarda" target="_blank" rel="noreferrer">LinkedIn</a>
            <a href="https://github.com/adarshsarda/" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>
      </div>
    </footer>

    <Terminal lang={lang} />
    <KeyboardControls lang={lang} />

    <script>
      // Scroll reveal: fade/slide elements in as they enter the viewport.
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal, .reveal-stagger');
      if (revealEls.length) {
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
          revealEls.forEach((el) => io.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        }
      }

      // Reading progress bar (present on article pages only).
      const progressBar = document.querySelector<HTMLElement>('[data-reading-progress]');
      if (progressBar) {
        let ticking = false;
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
      }
    </script>
  </body>
</html>
